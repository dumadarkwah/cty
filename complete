        private void FindButton_Click(object sender, EventArgs e)
        {
            if (searchTextBox == null || string.IsNullOrWhiteSpace(searchTextBox.Text))
            {
                MessageBox.Show("Please enter a keyword or Regex to search!", "Notification", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
            TabPage currentTab = tabControlFiles.SelectedTab;

            if (!openedTabs.ContainsKey(currentTab)) return;
            var tabInfo = openedTabs[currentTab];

            List<ListViewItem> sourceLines = tabInfo.RealLines;
            if (sourceLines == null || sourceLines.Count == 0) return;

            string rawInput = searchTextBox.Text.Trim();
            bool isRegexMode = Regex.IsMatch(rawInput, @"[\.\*\+\?^${}()|[\]\\]");

            try
            {
                // =========================================================================
                // ⚡ CHẾ ĐỘ 1: TÌM KIẾM REGEX (IN LOG RA OUTPUT + HIGHLIGHT SẴN SÁNG RỰC)
                // =========================================================================
                if (isRegexMode)
                {
                    // Reset màu nền cũ
                    foreach (var line in sourceLines) line.BackColor = Color.White;

                    var searchResults = new List<SearchResultItem>();
                    Regex regex = new Regex(rawInput, RegexOptions.IgnoreCase);

                    for (int i = 0; i < sourceLines.Count; i++)
                    {
                        string hexData = sourceLines[i].SubItems[1].Text;
                        Match mHex = regex.Match(hexData);
                        if (mHex.Success)
                        {
                            searchResults.Add(new SearchResultItem { LineIndex = i, Offset = sourceLines[i].Text, HexData = hexData, DecodedText = sourceLines[i].SubItems[2].Text, MatchIndexInColumn = mHex.Index, ActualMatchLength = mHex.Length, MatchedInHex = true });
                            sourceLines[i].BackColor = Color.Yellow; // Highlight sẵn màu vàng rực trong bộ đệm dữ liệu
                            continue;
                        }

                        string decodedText = sourceLines[i].SubItems[2].Text;
                        Match mText = regex.Match(decodedText);
                        if (mText.Success)
                        {
                            searchResults.Add(new SearchResultItem { LineIndex = i, Offset = sourceLines[i].Text, HexData = hexData, DecodedText = decodedText, MatchIndexInColumn = mText.Index, ActualMatchLength = mText.Length, MatchedInHex = false });
                            sourceLines[i].BackColor = Color.Yellow; // Highlight sẵn màu vàng rực trong bộ đệm dữ liệu
                        }
                    }

                    if (searchResults.Count == 0)
                    {
                        if (tabInfo.VirtualScrollBar != null) RenderVirtualPage(tabInfo.DisplayGrid, sourceLines, tabInfo.VirtualScrollBar.Value);
                        MessageBox.Show($"No Regex matches found for '{rawInput}'.", "Search Result", MessageBoxButtons.OK, MessageBoxIcon.Information);
                        return;
                    }

                    // In log đúng 1 lần ra Output
                    WriteOutputLog($"[Regex Found] Found {searchResults.Count} match(es) for '{rawInput}'. Click below to jump:");

                    if (rtbOutput != null)
                    {
                        foreach (var res in searchResults)
                        {
                            string context = res.MatchedInHex ? res.HexData : res.DecodedText;
                            if (context.Length > 45) context = context.Substring(0, 42) + "...";

                            rtbOutput.SelectionStart = rtbOutput.Text.Length;
                            rtbOutput.SelectionLength = 0;
                            rtbOutput.SelectionColor = Color.DodgerBlue;
                            rtbOutput.AppendText($"    👉 [Line:{res.LineIndex + 1} | Offset:{res.Offset}]");

                            rtbOutput.SelectionColor = Color.DarkGray;
                            rtbOutput.AppendText($" -> Content: {context}\n");
                        }
                        rtbOutput.SelectionStart = rtbOutput.Text.Length;
                        rtbOutput.ScrollToCaret();
                    }

                    // Tự động nhảy tới và hiển thị highlight dòng đầu tiên luôn
                    if (tabInfo.VirtualScrollBar != null)
                    {
                        int firstMatchLine = searchResults[0].LineIndex;
                        tabInfo.VirtualScrollBar.Value = Math.Min(tabInfo.VirtualScrollBar.Maximum, Math.Max(0, firstMatchLine - 5));
                        int startViewIndex = tabInfo.VirtualScrollBar.Value;

                        RenderVirtualPage(tabInfo.DisplayGrid, sourceLines, startViewIndex);

                        int relativeIndex = firstMatchLine - startViewIndex;
                        if (relativeIndex >= 0 && relativeIndex < tabInfo.DisplayGrid.Items.Count)
                        {
                            tabInfo.DisplayGrid.Focus();
                            tabInfo.DisplayGrid.Items[relativeIndex].Selected = true;
                            tabInfo.DisplayGrid.Items[relativeIndex].EnsureVisible();
                        }
                        tabInfo.DisplayGrid.Refresh();
                    }
                }
                // =========================================================================
                // ✂️ CHẾ ĐỘ 2: TÌM KIẾM THƯỜNG (RÀ TỪ DƯỚI LÊN, XÓA DỮ LIỆU FILE THẲNG, KHÔNG OUTPUT)
                // =========================================================================
                else
                {
                    string cleanInput = rawInput.Replace(" ", "").ToLower();
                    int foundLineIndex = -1;
                    int matchPosInString = -1;
                    bool isHexMatch = false;

                    for (int i = sourceLines.Count - 1; i >= 0; i--)
                    {
                        string hexOriginal = sourceLines[i].SubItems[1].Text;
                        string hexClean = hexOriginal.Replace(" ", "").ToLower();

                        int idxHex = hexClean.LastIndexOf(cleanInput);
                        if (idxHex != -1)
                        {
                            foundLineIndex = i;
                            matchPosInString = idxHex;
                            isHexMatch = true;
                            break;
                        }

                        string decodedText = sourceLines[i].SubItems[2].Text.ToLower();
                        int idxText = decodedText.LastIndexOf(rawInput.ToLower());
                        if (idxText != -1)
                        {
                            foundLineIndex = i;
                            matchPosInString = idxText;
                            isHexMatch = false;
                            break;
                        }
                    }

                    if (foundLineIndex == -1)
                    {
                        MessageBox.Show($"Search target '{rawInput}' not found in the entire file.", "Search Result", MessageBoxButtons.OK, MessageBoxIcon.Information);
                        return;
                    }

                    // 1. Thực hiện xóa toàn bộ các dòng nằm PHÍA DƯỚI dòng tìm thấy trở xuống
                    if (sourceLines.Count > foundLineIndex + 1)
                    {
                        sourceLines.RemoveRange(foundLineIndex + 1, sourceLines.Count - (foundLineIndex + 1));
                    }

                    // 2. Tiến hành chặt đuôi ngay trên chính dòng tìm thấy
                    ListViewItem targetLine = sourceLines[foundLineIndex];
                    if (isHexMatch)
                    {
                        string hexOriginal = targetLine.SubItems[1].Text;
                        string hexClean = hexOriginal.Replace(" ", "");

                        string cutHexClean = hexClean.Substring(0, matchPosInString + cleanInput.Length);

                        StringBuilder sb = new StringBuilder();
                        for (int k = 0; k < cutHexClean.Length; k += 2)
                        {
                            if (k + 2 <= cutHexClean.Length)
                                sb.Append(cutHexClean.Substring(k, 2) + " ");
                            else
                                sb.Append(cutHexClean.Substring(k) + " ");
                        }
                        targetLine.SubItems[1].Text = sb.ToString().Trim().ToUpper();
                    }
                    else
                    {
                        string currentText = targetLine.SubItems[2].Text;
                        targetLine.SubItems[2].Text = currentText.Substring(0, matchPosInString + rawInput.Length);
                    }

                    // Highlight nhuộm vàng dòng chốt hạ này trong bộ nhớ dữ liệu
                    targetLine.BackColor = Color.Yellow;

                    tabInfo.IsShaped = true;

                    // 3. Ép giao diện vẽ lại chuẩn xác
                    if (tabInfo.DisplayGrid != null)
                    {
                        if (tabInfo.VirtualScrollBar != null)
                        {
                            tabInfo.VirtualScrollBar.Maximum = Math.Max(0, sourceLines.Count - MAX_DISPLAY_LINES);
                            tabInfo.VirtualScrollBar.Value = Math.Min(tabInfo.VirtualScrollBar.Maximum, Math.Max(0, foundLineIndex - 5));
                        }

                        int startViewIndex = tabInfo.VirtualScrollBar != null ? tabInfo.VirtualScrollBar.Value : 0;

                        RenderVirtualPage(tabInfo.DisplayGrid, sourceLines, startViewIndex);

                        int relativeIndex = foundLineIndex - startViewIndex;
                        if (relativeIndex >= 0 && relativeIndex < tabInfo.DisplayGrid.Items.Count)
                        {
                            tabInfo.DisplayGrid.Focus();
                            tabInfo.DisplayGrid.Items[relativeIndex].Selected = true;
                            tabInfo.DisplayGrid.Items[relativeIndex].EnsureVisible();
                        }

                        tabInfo.DisplayGrid.Refresh();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error during search: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void RtbOutput_MouseClick(object sender, MouseEventArgs e)
        {
            if (rtbOutput == null || string.IsNullOrEmpty(rtbOutput.Text)) return;

            try
            {
                int charIndex = rtbOutput.GetCharIndexFromPosition(e.Location);
                int lineIndex = rtbOutput.GetLineFromCharIndex(charIndex);
                string currentLineText = rtbOutput.Lines[lineIndex];

                Match m = Regex.Match(currentLineText, @"\[Line:(\d+)\s*\|\s*Offset:([0-9A-Fa-f]+)\]");

                if (m.Success)
                {
                    int targetLineIndex = int.Parse(m.Groups[1].Value) - 1;

                    if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
                    TabPage currentTab = tabControlFiles.SelectedTab;
                    if (!openedTabs.ContainsKey(currentTab)) return;
                    var tabInfo = openedTabs[currentTab];
                    List<ListViewItem> sourceLines = tabInfo.RealLines;

                    if (targetLineIndex < 0 || targetLineIndex >= sourceLines.Count) return;

                    if (tabInfo.VirtualScrollBar != null)
                    {
                        tabInfo.VirtualScrollBar.Maximum = Math.Max(0, sourceLines.Count - MAX_DISPLAY_LINES);
                        tabInfo.VirtualScrollBar.Value = Math.Min(tabInfo.VirtualScrollBar.Maximum, Math.Max(0, targetLineIndex - 5));
                    }
                    int startViewIndex = tabInfo.VirtualScrollBar != null ? tabInfo.VirtualScrollBar.Value : 0;

                    RenderVirtualPage(tabInfo.DisplayGrid, sourceLines, startViewIndex);

                    if (tabInfo.DisplayGrid != null && tabInfo.DisplayGrid.Items.Count > 0)
                    {
                        tabInfo.DisplayGrid.Focus();
                        int relativeIndex = targetLineIndex - startViewIndex;
                        if (relativeIndex >= 0 && relativeIndex < tabInfo.DisplayGrid.Items.Count)
                        {
                            tabInfo.DisplayGrid.Items[relativeIndex].Selected = true;
                            tabInfo.DisplayGrid.Items[relativeIndex].EnsureVisible();
                        }
                    }
                }
            }
            catch { }
        }

        private void SaveButton_Click(object sender, EventArgs e)
        {
            List<FileTabInfo> shapedFiles = new List<FileTabInfo>();
            foreach (var tabInfo in openedTabs.Values)
            {
                if (tabInfo.IsShaped) shapedFiles.Add(tabInfo);
            }

            if (shapedFiles.Count == 0)
            {
                MessageBox.Show("No files have been modified or shaped yet!", "Notification", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            Form saveForm = new Form();
            saveForm.Text = "Save Manager - Command Data Shaping Tool";
            saveForm.Size = new Size(500, 400);
            saveForm.StartPosition = FormStartPosition.CenterParent;
            saveForm.FormBorderStyle = FormBorderStyle.FixedDialog;
            saveForm.MaximizeBox = false;

            Label lblInfo = new Label() { Text = $"Detected {shapedFiles.Count} modified file(s). Select files you want to save:", Location = new Point(15, 15), Size = new Size(450, 25), Font = new Font("Segoe UI", 9.5F, FontStyle.Bold) };
            CheckedListBox chkListBox = new CheckedListBox() { Location = new Point(15, 45), Size = new Size(455, 200), Font = new Font("Consolas", 9.5F) };

            foreach (var file in shapedFiles) chkListBox.Items.Add(Path.GetFileName(file.FilePath), true);

            GroupBox groupOptions = new GroupBox() { Text = "Choose Save Method", Location = new Point(15, 255), Size = new Size(455, 60) };
            RadioButton rdoOverwrite = new RadioButton() { Text = "Method 1: Overwrite original files", Location = new Point(15, 25), Size = new Size(200, 20), Checked = true };
            RadioButton rdoSaveAs = new RadioButton() { Text = "Method 2: Export to new folder", Location = new Point(230, 25), Size = new Size(200, 20) };
            groupOptions.Controls.Add(rdoOverwrite);
            groupOptions.Controls.Add(rdoSaveAs);

            Button btnExecute = new Button() { Text = "Execute Save", Location = new Point(265, 325), Size = new Size(100, 30) };
            Button btnCancel = new Button() { Text = "Cancel", Location = new Point(370, 325), Size = new Size(100, 30) };
            btnCancel.Click += (s, ev) => saveForm.Close();

            btnExecute.Click += (s, ev) => {
                if (chkListBox.CheckedItems.Count == 0)
                {
                    MessageBox.Show("Please select at least one file to save!", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }

                List<FileTabInfo> selectedToSave = new List<FileTabInfo>();
                for (int i = 0; i < chkListBox.Items.Count; i++)
                {
                    if (chkListBox.GetItemChecked(i)) selectedToSave.Add(shapedFiles[i]);
                }

                string exportFolder = "";
                if (rdoSaveAs.Checked)
                {
                    using (FolderBrowserDialog fbd = new FolderBrowserDialog())
                    {
                        fbd.Description = "Select a folder to export all selected shaped files:";
                        if (fbd.ShowDialog(saveForm) == DialogResult.OK) exportFolder = fbd.SelectedPath;
                        else return;
                    }
                }

                int successCount = 0;
                try
                {
                    foreach (var fileInfo in selectedToSave)
                    {
                        List<byte> outputBytes = new List<byte>();
                        foreach (ListViewItem item in fileInfo.RealLines)
                        {
                            string hexData = item.SubItems[1].Text.Trim();
                            if (string.IsNullOrEmpty(hexData)) continue;

                            string[] hexParts = hexData.Split(' ');
                            foreach (string part in hexParts)
                            {
                                if (!string.IsNullOrEmpty(part)) outputBytes.Add(Convert.ToByte(part, 16));
                            }
                        }

                        string finalSavePath = rdoOverwrite.Checked ? fileInfo.FilePath : Path.Combine(exportFolder, Path.GetFileName(fileInfo.FilePath));
                        File.WriteAllBytes(finalSavePath, outputBytes.ToArray());

                        if (rdoOverwrite.Checked) fileInfo.FileLength = outputBytes.Count;
                        fileInfo.IsShaped = false;
                        successCount++;
                        WriteOutputLog($"Saved shaped data to: {Path.GetFileName(finalSavePath)}");
                    }

                    MessageBox.Show($"Successfully saved {successCount} file(s)!", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    saveForm.Close();
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"Error saving files: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            };

            saveForm.Controls.Add(lblInfo);
            saveForm.Controls.Add(chkListBox);
            saveForm.Controls.Add(groupOptions);
            saveForm.Controls.Add(btnExecute);
            saveForm.Controls.Add(btnCancel);
            saveForm.ShowDialog(this);
        }

        private List<ListViewItem> GetAllFileLines(string filePath)
        {
            List<ListViewItem> list = new List<ListViewItem>();
            if (!File.Exists(filePath)) return list;

            System.Text.Encoding encodingNhat = System.Text.Encoding.GetEncoding("Shift-JIS");
            byte[] buffer = new byte[BYTES_PER_LINE];
            long offset = 0;

            try
            {
                using (FileStream fs = new FileStream(filePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                {
                    int bytesRead;
                    while ((bytesRead = fs.Read(buffer, 0, BYTES_PER_LINE)) > 0)
                    {
                        string offsetStr = offset.ToString("x8").ToUpper();
                        List<string> hexChunks = new List<string>();
                        for (int i = 0; i < bytesRead; i++) hexChunks.Add(buffer[i].ToString("x2").ToUpper());
                        string hexStr = string.Join(" ", hexChunks);
                        string rawText = encodingNhat.GetString(buffer, 0, bytesRead);
                        string cleanText = "";
                        foreach (char c in rawText) cleanText += (c != '\0' && !char.IsControl(c)) ? c : '.';

                        ListViewItem item = new ListViewItem(offsetStr);
                        item.SubItems.Add(hexStr);
                        item.SubItems.Add(cleanText);
                        list.Add(item);
                        offset += BYTES_PER_LINE;
                    }
                }
            }
            catch (Exception ex) { WriteOutputLog($"Read Error: {ex.Message}"); }
            return list;
        }

