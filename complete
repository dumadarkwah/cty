        private void AddFileToTab(string filePath)
        {
            if (string.IsNullOrEmpty(filePath) || !File.Exists(filePath)) return;

            string extensionLower = Path.GetExtension(filePath).ToLower();
            if (extensionLower != ".log" && extensionLower != ".bin") return;

            foreach (var item in openedTabs.Values)
            {
                if (item.FilePath.Equals(filePath, StringComparison.OrdinalIgnoreCase)) return;
            }

            FileInfo fi = new FileInfo(filePath);
            long fileLength = fi.Length;
            string fileName = fi.Name;

            TabPage newTab = new TabPage(fileName);
            Panel containerPanel = new Panel() { Dock = DockStyle.Fill };

            CustomListView newListView = new CustomListView();
            newListView.Dock = DockStyle.Fill;
            newListView.View = View.Details;
            newListView.Font = new Font("Consolas", 10F);
            newListView.GridLines = true;
            newListView.FullRowSelect = true;
            newListView.HideSelection = false;
            newListView.OwnerDraw = false;

            newListView.Columns.Add("Offset", 100);
            newListView.Columns.Add("Hex Data", 560);
            newListView.Columns.Add("Decoded Text", 250);

            newListView.DrawColumnHeader += (s, e) => e.DrawDefault = true;
            newListView.DrawItem += (s, e) => {
                if (!newListView.OwnerDraw) e.DrawDefault = true;
            };
            newListView.DrawSubItem += (s, e) => {
                if (!newListView.OwnerDraw)
                {
                    e.DrawDefault = true;
                    return;
                }

                if (tabControlFiles?.SelectedTab == null || !openedTabs.ContainsKey(tabControlFiles.SelectedTab))
                {
                    e.DrawDefault = true;
                    return;
                }

                var currentTabInfo = openedTabs[tabControlFiles.SelectedTab];
                if (!currentTabInfo.IsRegexHighlightActive || string.IsNullOrEmpty(currentTabInfo.CurrentSearchKeyword) || e.ColumnIndex == 0)
                {
                    e.DrawDefault = true;
                    return;
                }

                string text = e.SubItem.Text;
                int matchIndex = text.IndexOf(currentTabInfo.CurrentSearchKeyword, StringComparison.OrdinalIgnoreCase);

                if (matchIndex < 0)
                {
                    e.DrawDefault = true;
                    return;
                }

                e.Graphics.FillRectangle(SystemBrushes.Window, e.Bounds);

                using (Font font = newListView.Font)
                {
                    string prefix = text.Substring(0, matchIndex);
                    string matchText = text.Substring(matchIndex, currentTabInfo.CurrentSearchKeyword.Length);

                    int prefixWidth = TextRenderer.MeasureText(e.Graphics, prefix, font, Size.Empty, TextFormatFlags.NoPadding).Width;
                    int matchWidth = TextRenderer.MeasureText(e.Graphics, matchText, font, Size.Empty, TextFormatFlags.NoPadding).Width;

                    Rectangle highlightRect = new Rectangle(e.Bounds.X + prefixWidth + 4, e.Bounds.Y + 2, matchWidth, e.Bounds.Height - 4);
                    using (SolidBrush yellowBrush = new SolidBrush(Color.Yellow))
                    {
                        e.Graphics.FillRectangle(yellowBrush, highlightRect);
                    }

                    TextRenderer.DrawText(e.Graphics, text, font, e.Bounds.Location, Color.Black, TextFormatFlags.VerticalCenter | TextFormatFlags.Left);
                }
            };

            VScrollBar vScroll = new VScrollBar();
            vScroll.Name = "vScroll";
            vScroll.Dock = DockStyle.Right;
            vScroll.Minimum = 0;
            vScroll.Maximum = VIRTUAL_SCROLL_SCALE;
            vScroll.SmallChange = 500;
            vScroll.LargeChange = 2000;

            containerPanel.Controls.Add(newListView);
            containerPanel.Controls.Add(vScroll);
            newTab.Controls.Add(containerPanel);

            FileTabInfo tabInfo = new FileTabInfo
            {
                FilePath = filePath,
                FileLength = fileLength,
                DisplayGrid = newListView,
                VirtualScrollBar = vScroll
            };
            openedTabs.Add(newTab, tabInfo);

            newListView.MouseWheel += (s, e) => {
                int maxScrollVal = vScroll.Maximum - vScroll.LargeChange + 1;
                long totalLines = GetMaxScrollableLineIndex(tabInfo);
                if (totalLines <= 0) return;

                int linesToScroll = (e.Delta / 120) * 3;
                double stepVal = ((double)linesToScroll / totalLines) * maxScrollVal;

                int newValue = vScroll.Value - (int)Math.Round(stepVal);
                if (newValue < vScroll.Minimum) newValue = vScroll.Minimum;
                if (newValue > maxScrollVal) newValue = maxScrollVal;

                vScroll.Value = newValue;
                long computedLine = (long)Math.Round((double)vScroll.Value / maxScrollVal * totalLines);
                RenderVirtualPageStream(tabInfo, computedLine);
            };

            vScroll.Scroll += (s, e) => {
                int maxScrollVal = vScroll.Maximum - vScroll.LargeChange + 1;
                long totalLines = GetMaxScrollableLineIndex(tabInfo);

                int val = e.NewValue;
                if (val < vScroll.Minimum) val = vScroll.Minimum;
                if (val > maxScrollVal) val = maxScrollVal;

                long computedLine = (long)Math.Round((double)val / maxScrollVal * totalLines);
                RenderVirtualPageStream(tabInfo, computedLine);
            };

            if (tabControlFiles != null)
            {
                tabControlFiles.TabPages.Add(newTab);
                tabControlFiles.SelectedTab = newTab;
            }

            if (fileListBox != null)
            {
                fileListBox.Items.Add(fileName);
            }

            RenderVirtualPageStream(tabInfo, 0);
            WriteOutputLog($"Successfully opened: {fileName}");
        }

        private long GetMaxScrollableLineIndex(FileTabInfo tabInfo)
        {
            long totalFileLines = (long)Math.Ceiling((double)tabInfo.FileLength / BYTES_PER_LINE);
            return Math.Max(0, totalFileLines - 1);
        }
        private bool ParseInputToBytePattern(string input, out List<byte?> bytePattern, out bool isWildcardRegex)
        {
            bytePattern = new List<byte?>();
            isWildcardRegex = false;

            string[] tokens = input.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            if (tokens.Length == 0) return false;

            foreach (var token in tokens)
            {
                if (token == "." || token == ".." || token == "??")
                {
                    bytePattern.Add(null);
                    isWildcardRegex = true;
                }
                else if (byte.TryParse(token, System.Globalization.NumberStyles.HexNumber, null, out byte bVal))
                {
                    bytePattern.Add(bVal);
                }
                else
                {
                    bytePattern.Clear();
                    return false;
                }
            }

            return bytePattern.Count > 0;
        }

        private async void FindButton_Click(object sender, EventArgs e)
        {
            if (searchTextBox == null || string.IsNullOrWhiteSpace(searchTextBox.Text))
            {
                MessageBox.Show("Please enter a word search!", "Notification", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
            TabPage currentTab = tabControlFiles.SelectedTab;

            if (!openedTabs.ContainsKey(currentTab)) return;
            var tabInfo = openedTabs[currentTab];

            string rawInput = searchTextBox.Text.Trim();
            tabInfo.CurrentSearchKeyword = rawInput;

            searchCts?.Cancel();
            searchCts = new CancellationTokenSource();

            Control btn = (Control)sender;
            if (btn != null) btn.Enabled = false;

            if (!ParseInputToBytePattern(rawInput, out List<byte?> targetPattern, out bool isRegexWildcard))
            {
                MessageBox.Show("Invalid format!", "Invalid Input", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                if (btn != null) btn.Enabled = true;
                return;
            }

            tabInfo.IsRegexHighlightActive = isRegexWildcard;
            if (tabInfo.DisplayGrid != null)
            {
                tabInfo.DisplayGrid.OwnerDraw = isRegexWildcard; 
            }

            WriteOutputLog($" Mode: {(isRegexWildcard ? "REGEX" : "NORMAL HEX")} | Target Hex: '{rawInput}'...");

            try
            {
                var searchResults = await Task.Run(() =>
                {
                    var results = new List<SearchResultItem>();
                    Encoding shiftJis = Encoding.GetEncoding("Shift-JIS");

                    FileInfo fi = new FileInfo(tabInfo.FilePath);
                    tabInfo.FileLength = fi.Length;

                    long totalLines = (long)Math.Ceiling((double)tabInfo.FileLength / BYTES_PER_LINE);
                    byte[] buffer = new byte[BYTES_PER_LINE];

                    using (FileStream fs = new FileStream(tabInfo.FilePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                    {
                        if (isRegexWildcard)
                        {
                            long currentLineIndex = 0;
                            int bytesRead;
                            while ((bytesRead = fs.Read(buffer, 0, BYTES_PER_LINE)) > 0)
                            {
                                searchCts.Token.ThrowIfCancellationRequested();
                                long currentByteOffset = fs.Position - bytesRead;

                                bool isMatched = false;
                                if (targetPattern.Count <= bytesRead)
                                {
                                    for (int i = 0; i <= bytesRead - targetPattern.Count; i++)
                                    {
                                        bool matchAtOffset = true;
                                        for (int j = 0; j < targetPattern.Count; j++)
                                        {
                                            if (targetPattern[j].HasValue && buffer[i + j] != targetPattern[j].Value)
                                            {
                                                matchAtOffset = false;
                                                break;
                                            }
                                        }

                                        if (matchAtOffset) { isMatched = true; break; }
                                    }
                                }

                                if (isMatched)
                                {
                                    List<string> hexChunks = new List<string>();
                                    for (int k = 0; k < bytesRead; k++) hexChunks.Add(buffer[k].ToString("X2"));

                                    results.Add(new SearchResultItem
                                    {
                                        LineIndex = currentLineIndex,
                                        Offset = currentByteOffset.ToString("X8"),
                                        HexData = string.Join(" ", hexChunks),
                                        DecodedText = shiftJis.GetString(buffer, 0, bytesRead),
                                        MatchedInHex = true
                                    });
                                }

                                currentLineIndex++;
                            }
                        }
                        else
                        {
                            for (long lineIdx = totalLines - 1; lineIdx >= 0; lineIdx--)
                            {
                                searchCts.Token.ThrowIfCancellationRequested();

                                long currentByteOffset = lineIdx * BYTES_PER_LINE;
                                fs.Seek(currentByteOffset, SeekOrigin.Begin);

                                int bytesRead = fs.Read(buffer, 0, BYTES_PER_LINE);
                                if (bytesRead <= 0) continue;

                                if (targetPattern.Count <= bytesRead)
                                {
                                    for (int i = bytesRead - targetPattern.Count; i >= 0; i--)
                                    {
                                        bool match = true;
                                        for (int j = 0; j < targetPattern.Count; j++)
                                        {
                                            if (targetPattern[j].HasValue && buffer[i + j] != targetPattern[j].Value)
                                            {
                                                match = false;
                                                break;
                                            }
                                        }

                                        if (match)
                                        {
                                            int matchEndByteIndex = i + targetPattern.Count;
                                            long matchedByteCutoff = currentByteOffset + matchEndByteIndex;

                                            tabInfo.FileLength = matchedByteCutoff;

                                            List<string> hexChunks = new List<string>();
                                            for (int k = 0; k < matchEndByteIndex; k++) hexChunks.Add(buffer[k].ToString("X2"));

                                            results.Add(new SearchResultItem
                                            {
                                                LineIndex = lineIdx,
                                                Offset = currentByteOffset.ToString("X8"),
                                                HexData = string.Join(" ", hexChunks),
                                                DecodedText = shiftJis.GetString(buffer, 0, matchEndByteIndex),
                                                MatchedInHex = true
                                            });

                                            break;
                                        }
                                    }
                                }

                                if (results.Count > 0) break;
                            }
                        }
                    }

                    return results;
                }, searchCts.Token);

                if (searchResults.Count == 0)
                {
                    RenderVirtualPageStream(tabInfo, 0);
                    MessageBox.Show($"No result found for '{rawInput}'.", "Search Result", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }

                if (rtbOutput != null)
                {
                    rtbOutput.Clear();
                    if (isRegexWildcard)
                    {
                        WriteOutputLog($" Matched {searchResults.Count} item(s) for '{rawInput}':");
                        foreach (var res in searchResults)
                        {
                            rtbOutput.SelectionStart = rtbOutput.Text.Length;
                            rtbOutput.SelectionLength = 0;

                            rtbOutput.SelectionColor = Color.DodgerBlue;
                            rtbOutput.AppendText($"[Offset:{res.Offset}] ");

                            rtbOutput.SelectionColor = Color.LightGray;
                            rtbOutput.AppendText($"{res.HexData}\n");
                        }
                    }
                    else
                    {
                        WriteOutputLog($"Deleted trailing data after '{rawInput}'!");
                        rtbOutput.SelectionStart = rtbOutput.Text.Length;
                        rtbOutput.SelectionLength = 0;

                        rtbOutput.SelectionColor = Color.DodgerBlue;
                        rtbOutput.AppendText($"[Offset:{searchResults[0].Offset}] ");

                        rtbOutput.SelectionColor = Color.LimeGreen;
                        rtbOutput.AppendText($"{searchResults[0].HexData}\n");
                    }
                    rtbOutput.ScrollToCaret();
                }
                NavigateToLine(tabInfo, searchResults[0].LineIndex);
            }
            catch (OperationCanceledException)
            {
                WriteOutputLog("Task was cancelled.");
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Search Error: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                if (btn != null) btn.Enabled = true;
            }
        }

        private void NavigateToLine(FileTabInfo tabInfo, long targetLineIndex)
        {
            long totalLines = GetMaxScrollableLineIndex(tabInfo);
            if (tabInfo.VirtualScrollBar != null && totalLines > 0)
            {
                int maxScrollVal = tabInfo.VirtualScrollBar.Maximum - tabInfo.VirtualScrollBar.LargeChange + 1;
                double ratio = (double)targetLineIndex / totalLines;
                tabInfo.VirtualScrollBar.Value = (int)Math.Min(maxScrollVal, Math.Max(0, ratio * maxScrollVal));
            }

            long startViewIndex = Math.Max(0, targetLineIndex - 2);
            RenderVirtualPageStream(tabInfo, startViewIndex);

            if (tabInfo.DisplayGrid != null)
            {
                int relativeIndex = (int)(targetLineIndex - startViewIndex);
                if (relativeIndex >= 0 && relativeIndex < tabInfo.DisplayGrid.Items.Count)
                {
                    tabInfo.DisplayGrid.Focus();
                    tabInfo.DisplayGrid.SelectedItems.Clear();
                    tabInfo.DisplayGrid.Items[relativeIndex].Selected = true;
                    tabInfo.DisplayGrid.Items[relativeIndex].Focused = true;
                    tabInfo.DisplayGrid.Items[relativeIndex].EnsureVisible();
                }
            }
        }

        private void RtbOutput_MouseClick(object sender, MouseEventArgs e)
        {
            if (rtbOutput == null || string.IsNullOrEmpty(rtbOutput.Text)) return;

            try
            {
                int charIndex = rtbOutput.GetCharIndexFromPosition(e.Location);
                int lineIndex = rtbOutput.GetLineFromCharIndex(charIndex);
                if (lineIndex < 0 || lineIndex >= rtbOutput.Lines.Length) return;

                string currentLineText = rtbOutput.Lines[lineIndex];

                Match m = Regex.Match(currentLineText, @"\[Offset:([0-9A-Fa-f]+)\]");

                if (m.Success)
                {
                    string hexOffsetStr = m.Groups[1].Value;
                    long byteOffset = Convert.ToInt64(hexOffsetStr, 16);

                    long targetLineIndex = byteOffset / BYTES_PER_LINE;

                    if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
                    TabPage currentTab = tabControlFiles.SelectedTab;
                    if (!openedTabs.ContainsKey(currentTab)) return;
                    var tabInfo = openedTabs[currentTab];

                    NavigateToLine(tabInfo, targetLineIndex);
                }
            }
            catch { }
        }

        private void RenderVirtualPageStream(FileTabInfo tabInfo, long startIndex)
        {
            if (tabInfo == null || tabInfo.DisplayGrid == null || !File.Exists(tabInfo.FilePath)) return;

            ListView lv = tabInfo.DisplayGrid;
            lv.BeginUpdate();
            lv.Items.Clear();

            System.Text.Encoding encodingNhat = System.Text.Encoding.GetEncoding("Shift-JIS");
            byte[] buffer = new byte[BYTES_PER_LINE];

            try
            {
                using (FileStream fs = new FileStream(tabInfo.FilePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                {
                    for (int i = 0; i < MAX_DISPLAY_LINES; i++)
                    {
                        long exactLineOffset = (startIndex + i) * BYTES_PER_LINE;

                        if (exactLineOffset >= tabInfo.FileLength) break;

                        fs.Seek(exactLineOffset, SeekOrigin.Begin);

                        int bytesToRead = BYTES_PER_LINE;
                        if (exactLineOffset + bytesToRead > tabInfo.FileLength)
                        {
                            bytesToRead = (int)(tabInfo.FileLength - exactLineOffset);
                        }

                        int bytesRead = fs.Read(buffer, 0, bytesToRead);
                        if (bytesRead <= 0) break;

                        string offsetStr = exactLineOffset.ToString("X8");
                        List<string> hexChunks = new List<string>();
                        for (int k = 0; k < bytesRead; k++) hexChunks.Add(buffer[k].ToString("X2"));
                        string hexStr = string.Join(" ", hexChunks);

                        string rawText = encodingNhat.GetString(buffer, 0, bytesRead);
                        string cleanText = "";
                        foreach (char c in rawText) cleanText += (c != '\0' && !char.IsControl(c)) ? c : '.';

                        ListViewItem item = new ListViewItem(offsetStr);
                        item.SubItems.Add(hexStr);
                        item.SubItems.Add(cleanText);

                        lv.Items.Add(item);
                    }
                }
            }
            catch { }
            lv.EndUpdate();
        }

        private void WriteOutputLog(string content)
        {
            if (rtbOutput == null) return;
            if (rtbOutput.InvokeRequired) { rtbOutput.Invoke(new Action<string>(WriteOutputLog), content); return; }

            Color msgColor = Color.LightGray;
            if (content.Contains("[Folder Scan]") || content.Contains("Successfully") || content.Contains("[Truncated Success]") || content.Contains("[Found Regex]"))
                msgColor = Color.LimeGreen;
            else if (content.Contains("Error") || content.Contains("Fail"))
                msgColor = Color.Tomato;

            rtbOutput.SelectionStart = rtbOutput.Text.Length;
            rtbOutput.SelectionLength = 0;
            rtbOutput.SelectionColor = Color.Gray;
            rtbOutput.AppendText($"[{DateTime.Now:HH:mm:ss}] ");
            rtbOutput.SelectionColor = msgColor;
            rtbOutput.AppendText(content + "\n");
            rtbOutput.ScrollToCaret();
        }

        private void ExecuteSafeFolderScan()
        {
            using (var dialog = new CommonOpenFileDialog())
            {
                dialog.IsFolderPicker = true;
                dialog.Title = "Choose Folder";
                dialog.EnsurePathExists = true;

                if (dialog.ShowDialog() == CommonFileDialogResult.Ok)
                {
                    try
                    {
                        string targetDirectory = dialog.FileName;

                        if (!string.IsNullOrEmpty(targetDirectory) && Directory.Exists(targetDirectory))
                        {
                            DirectoryInfo di = new DirectoryInfo(targetDirectory);
                            string[] searchPatterns = { "*.log", "*.bin" };
                            List<FileInfo> filteredFiles = new List<FileInfo>();

                            foreach (string pattern in searchPatterns)
                            {
                                filteredFiles.AddRange(di.GetFiles(pattern, SearchOption.AllDirectories));
                            }

                            foreach (FileInfo fileInfo in filteredFiles)
                            {
                                AddFileToTab(fileInfo.FullName);
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show(ex.Message, "Error");
                    }
                }
            }
        }

