        private void AddFileToTab(string filePath)
        {
            if (string.IsNullOrEmpty(filePath) || !File.Exists(filePath)) return;

            string extensionLower = Path.GetExtension(filePath).ToLower();
            if (extensionLower != ".log" && extensionLower != ".bin") return;

            foreach (var item in openedTabs.Values)
            {
                if (item.FilePath.Equals(filePath, StringComparison.OrdinalIgnoreCase)) return;
            }

            FileInfo fi = new FileInfo(filePath);
            long fileLength = fi.Length;
            string fileName = fi.Name;

            TabPage newTab = new TabPage(fileName);
            Panel containerPanel = new Panel() { Dock = DockStyle.Fill };

            ListView newListView = new ListView();
            newListView.Dock = DockStyle.Fill;
            newListView.View = View.Details;
            newListView.Font = new Font("Consolas", 10F);
            newListView.GridLines = true;
            newListView.FullRowSelect = true;
            newListView.Columns.Add("Offset", 100);
            newListView.Columns.Add("Hex Data", 380);
            newListView.Columns.Add("Decoded Text", 200);

            List<ListViewItem> allLines = GetAllFileLines(filePath);

            VScrollBar vScroll = new VScrollBar();
            vScroll.Name = "vScroll";
            vScroll.Dock = DockStyle.Right;
            vScroll.Minimum = 0;
            vScroll.Maximum = Math.Max(0, allLines.Count - MAX_DISPLAY_LINES);

            containerPanel.Controls.Add(newListView);
            containerPanel.Controls.Add(vScroll);
            newTab.Controls.Add(containerPanel);

            FileTabInfo tabInfo = new FileTabInfo
            {
                FilePath = filePath,
                FileLength = fileLength,
                DisplayGrid = newListView,
                VirtualScrollBar = vScroll,
                RealLines = allLines,
                IsShaped = false
            };
            openedTabs.Add(newTab, tabInfo);

            newListView.MouseWheel += (s, e) => {
                if (containerPanel.Controls.ContainsKey("vScroll"))
                {
                    VScrollBar sb = (VScrollBar)containerPanel.Controls["vScroll"];
                    int newValue = sb.Value - (e.Delta / 120);
                    if (newValue >= sb.Minimum && newValue <= sb.Maximum)
                    {
                        sb.Value = newValue;
                        RenderVirtualPage(newListView, tabInfo.RealLines, sb.Value);
                    }
                }
            };

            vScroll.Scroll += (s, e) => {
                RenderVirtualPage(newListView, tabInfo.RealLines, e.NewValue);
            };

            if (tabControlFiles != null)
            {
                tabControlFiles.TabPages.Add(newTab);
                tabControlFiles.SelectedTab = newTab;
            }

            if (fileListBox != null)
            {
                fileListBox.Items.Add(fileName);
            }

            RenderVirtualPage(newListView, tabInfo.RealLines, 0);
            WriteOutputLog($"Successfully opened: {fileName}");
        }

        private void ExecuteSafeFolderScan()
        {
            using (var dialog = new CommonOpenFileDialog())
            {
                dialog.IsFolderPicker = true;
                dialog.Title = "Chọn Thư Mục";
                dialog.EnsurePathExists = true;

                if (dialog.ShowDialog() == CommonFileDialogResult.Ok)
                {
                    try
                    {
                        string targetDirectory = dialog.FileName;

                        if (!string.IsNullOrEmpty(targetDirectory) && Directory.Exists(targetDirectory))
                        {
                            DirectoryInfo di = new DirectoryInfo(targetDirectory);
                            string[] searchPatterns = { "*.log", "*.bin" };
                            List<FileInfo> filteredFiles = new List<FileInfo>();

                            foreach (string pattern in searchPatterns)
                            {
                                filteredFiles.AddRange(di.GetFiles(pattern, SearchOption.AllDirectories));
                            }

                            int loadedCount = 0;
                            foreach (FileInfo fileInfo in filteredFiles)
                            {
                                AddFileToTab(fileInfo.FullName);
                                loadedCount++;
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show(ex.Message, "Lỗi");
                    }
                }
            }
        }

