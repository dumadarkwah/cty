        private Dictionary<TabPage, FileTabInfo> openedTabs = new Dictionary<TabPage, FileTabInfo>();
        private const int BYTES_PER_LINE = 16;
        private const int MAX_DISPLAY_LINES = 50;
        private const int VIRTUAL_SCROLL_SCALE = 100000;

