        private void RenderVirtualPage(ListView lv, List<ListViewItem> lines, int startIndex)
        {
            if (lv == null || lines == null) return;
            lv.BeginUpdate();
            lv.Items.Clear();

            int count = Math.Min(MAX_DISPLAY_LINES, lines.Count - startIndex);
            for (int i = 0; i < count; i++)
            {
                ListViewItem original = lines[startIndex + i];
                ListViewItem clone = new ListViewItem(original.Text);
                clone.SubItems.Add(original.SubItems[1].Text); // Giữ chuỗi dữ liệu Hex đã bị cắt
                clone.SubItems.Add(original.SubItems[2].Text);

                // Đồng bộ giữ nguyên màu nền nhuộm vàng rực từ bộ nhớ lên màn hình ảo
                clone.BackColor = original.BackColor;

                lv.Items.Add(clone);
            }
            lv.EndUpdate();
        }

        private void WriteOutputLog(string content)
        {
            if (rtbOutput == null) return;
            if (rtbOutput.InvokeRequired) { rtbOutput.Invoke(new Action<string>(WriteOutputLog), content); return; }

            Color msgColor = Color.LightGray;
            if (content.Contains("[Folder Scan]") || content.Contains("Successfully") || content.Contains("Shaped]") || content.Contains("[File Saved]") || content.Contains("Found]"))
                msgColor = Color.LimeGreen;
            else if (content.Contains("Error") || content.Contains("Fail"))
                msgColor = Color.Tomato;

            rtbOutput.SelectionStart = rtbOutput.Text.Length;
            rtbOutput.SelectionLength = 0;
            rtbOutput.SelectionColor = Color.Gray;
            rtbOutput.AppendText($"[{DateTime.Now:HH:mm:ss}] ");
            rtbOutput.SelectionColor = msgColor;
            rtbOutput.AppendText(content + "\n");
            rtbOutput.SelectionStart = rtbOutput.Text.Length;
            rtbOutput.ScrollToCaret();
        }

        private void FileListBox_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (fileListBox == null || fileListBox.SelectedItem == null) return;
            string selectedFileName = fileListBox.SelectedItem.ToString();

            if (tabControlFiles != null)
            {
                foreach (TabPage tab in tabControlFiles.TabPages)
                {
                    if (tab.Text == selectedFileName)
                    {
                        tabControlFiles.SelectedTab = tab;

                        if (openedTabs.ContainsKey(tab))
                        {
                            var tabInfo = openedTabs[tab];
                            if (tabInfo.DisplayGrid != null)
                            {
                                tabInfo.DisplayGrid.Focus();

                                if (tabInfo.DisplayGrid.Items.Count > 0 && tabInfo.DisplayGrid.SelectedItems.Count == 0)
                                {
                                    tabInfo.DisplayGrid.Items[0].Selected = true;
                                }
                            }
                        }
                        break;
                    }
                }
            }
        }

