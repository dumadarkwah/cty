        private void SelectFilesMenuItem_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog ofd = new OpenFileDialog())
            {
                ofd.Title = "Open Log or Bin Files";
                ofd.Filter = "Log & Bin Files (*.log; *.bin)|*.log;*.bin";
                ofd.Multiselect = true;
                ofd.RestoreDirectory = true;

                if (ofd.ShowDialog(this) == DialogResult.OK)
                {
                    foreach (string file in ofd.FileNames) AddFileToTab(file);
                }
            }
        }
