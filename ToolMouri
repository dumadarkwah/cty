        // =========================================================================
        // NÚT TÌM KIẾM TỰ ĐỘNG CHUẨN: GÕ HEX RA HEX, GÕ "74 .. 67" RA REGEX CHUẨN ĐÉT
        // =========================================================================
        private void button2_Click_1(object sender, EventArgs e)
        {
            string chuoiGoc = textBox1.Text.Trim();

            if (string.IsNullOrEmpty(chuoiGoc)) return;
            if (tabControlFiles.TabPages.Count == 0)
            {
                GhiLogOutput("検索を実行する前にファイルを開いてください！");
                return;
            }

            // Chuẩn hóa chuỗi để kiểm tra xem có phải mã Hex thuần túy không
            string chuoiNhapHex = chuoiGoc.ToUpper().Replace(" ", "");

            // 🌟 KỊCH BẢN 1: Nếu người dùng nhập HEX thuần không dấu (Ví dụ: 746167) -> Chạy tìm Hex gốc
            if (System.Text.RegularExpressions.Regex.IsMatch(chuoiNhapHex, @"^[0-9A-F]+$") && chuoiNhapHex.Length % 2 == 0)
            {
                int mảngSize = chuoiNhapHex.Length / 2;
                byte[] bytesCanTim = new byte[mảngSize];
                for (int i = 0; i < mảngSize; i++)
                {
                    bytesCanTim[i] = Convert.ToByte(chuoiNhapHex.Substring(i * 2, 2), 16);
                }

                GhiLogOutput($"\n--- 検索スキャン開始（Hex）: [{chuoiGoc.ToUpper()}] ---");
                int soFileHex = 0;

                foreach (TabPage tab in tabControlFiles.TabPages)
                {
                    if (!danhSachTabMo.ContainsKey(tab)) continue;

                    ThongTinFileTab fileInfo = danhSachTabMo[tab];
                    byte[] fileBytesGoc = fileInfo.DuLieuGocBytes ?? fileInfo.DuLieuBytes;
                    if (fileBytesGoc == null || fileBytesGoc.Length < bytesCanTim.Length) continue;

                    string tenFile = Path.GetFileName(fileInfo.DuongDanFile);
                    int viTriByteTimThay = -1;

                    for (int i = fileBytesGoc.Length - bytesCanTim.Length; i >= 0; i--)
                    {
                        bool khopHoanToan = true;
                        for (int j = 0; j < bytesCanTim.Length; j++)
                        {
                            if (fileBytesGoc[i + j] != bytesCanTim[j])
                            {
                                khopHoanToan = false;
                                break;
                            }
                        }
                        if (khopHoanToan) { viTriByteTimThay = i; break; }
                    }

                    if (viTriByteTimThay != -1)
                    {
                        int viTriByteChatDuoi = viTriByteTimThay + bytesCanTim.Length;
                        byte[] temporaryBytes = new byte[viTriByteChatDuoi];
                        Array.Copy(fileBytesGoc, 0, temporaryBytes, 0, viTriByteChatDuoi);
                        fileInfo.DuLieuBytes = temporaryBytes;

                        CapNhatDuLieuLenListView(fileInfo.BangHienThi, fileInfo.DuLieuBytes);

                        ListView lv = fileInfo.BangHienThi;
                        if (lv != null && lv.Items.Count > 0)
                        {
                            int rowIndex = viTriByteTimThay / 16;
                            if (rowIndex >= lv.Items.Count) rowIndex = lv.Items.Count - 1;
                            if (rowIndex < 0) rowIndex = 0;

                            lv.Items[rowIndex].Selected = true;
                            lv.Items[rowIndex].Focused = true;
                            lv.Items[rowIndex].BackColor = System.Drawing.Color.LightGreen;
                            lv.Items[rowIndex].EnsureVisible();
                        }

                        GhiLogDieuHuong(tenFile, chuoiGoc.ToUpper());
                        soFileHex++;
                    }
                }
                GhiLogOutput($"--- 完了: {soFileHex} 個のファイルが見つかりました（Hex）。--- \n");
            }
            // 🌟 KỊCH BẢN 2: Nếu chuỗi nhập vào có chứa ".." hoặc chữ (Ví dụ: 74 .. 67) -> Chạy tìm Regex cột Hex + Text
            else
            {
                Regex regex;
                try
                {
                    // Chuyển chữ hoa để khớp chuẩn với bảng hiển thị ListView
                    string patternXuLy = chuoiGoc.ToUpper();
                    regex = new Regex(patternXuLy, RegexOptions.IgnoreCase);
                }
                catch (Exception ex)
                {
                    GhiLogOutput("Regex Error (Cú pháp lỗi): " + ex.Message);
                    return;
                }

                GhiLogOutput($"\n--- Regex検索スキャン開始: [{chuoiGoc}] ---");
                int soFileRegex = 0;

                foreach (TabPage tab in tabControlFiles.TabPages)
                {
                    if (!danhSachTabMo.ContainsKey(tab)) continue;

                    ThongTinFileTab fileInfo = danhSachTabMo[tab];
                    ListView lv = fileInfo.BangHienThi;
                    if (lv == null || lv.Items.Count == 0) continue;

                    bool fileNayCoKhop = false;
                    int dongTimThayDauTien = -1;
                    string chuoiKhopDauTien = "";

                    for (int rowIndex = 0; rowIndex < lv.Items.Count; rowIndex++)
                    {
                        if (lv.Items[rowIndex].SubItems.Count > 2)
                        {
                            // Lấy chuỗi hiển thị ở cột mã Hex (giữa) và cột text (phải)
                            string cotHex = lv.Items[rowIndex].SubItems[1].Text.ToUpper();
                            string cotText = lv.Items[rowIndex].SubItems[2].Text;

                            Match mHex = regex.Match(cotHex);
                            Match mText = regex.Match(cotText);

                            if (mHex.Success || mText.Success)
                            {
                                fileNayCoKhop = true;
                                lv.Items[rowIndex].Selected = true;
                                lv.Items[rowIndex].Focused = true;
                                lv.Items[rowIndex].BackColor = System.Drawing.Color.LightGreen;

                                if (dongTimThayDauTien == -1)
                                {
                                    dongTimThayDauTien = rowIndex;
                                    // Ưu tiên hiển thị chuỗi khớp của cột Hex lên Log điều hướng
                                    chuoiKhopDauTien = mHex.Success ? mHex.Value : mText.Value;
                                }
                            }
                            else
                            {
                                // Trả lại màu nền trắng nếu dòng này không có kết quả khớp
                                lv.Items[rowIndex].BackColor = System.Drawing.SystemColors.Window;
                            }
                        }
                    }

                    if (fileNayCoKhop)
                    {
                        soFileRegex++;
                        string tenFile = Path.GetFileName(fileInfo.DuongDanFile);
                        if (dongTimThayDauTien != -1) lv.Items[dongTimThayDauTien].EnsureVisible();
                        GhiLogDieuHuong(tenFile, chuoiKhopDauTien);
                    }
                }
                GhiLogOutput($"--- Regex完了: {soFileRegex} 個のファイルが見つかりました。--- \n");
            }
        }

        // =========================================================================
        // 🌟 HÀM MỚI TOÀN DIỆN: TÌM KIẾM TEXT / LOG BẰNG PHƯƠNG PHÁP REGEX
        // =========================================================================
        private void TimKiemBangRegex(string pattern)
        {
            Regex regex;
            try
            {
                // Khởi tạo Regex (Không phân biệt chữ hoa, chữ thường cho tiện)
                regex = new Regex(pattern, RegexOptions.IgnoreCase);
            }
            catch (Exception ex)
            {
                GhiLogOutput("Regex Error (Cú pháp lỗi): " + ex.Message);
                return;
            }

            GhiLogOutput($"\n--- Regex検索スキャン開始: [{pattern}] ---");
            int soFileTimThay = 0;

            foreach (TabPage tab in tabControlFiles.TabPages)
            {
                if (!danhSachTabMo.ContainsKey(tab)) continue;

                ThongTinFileTab fileInfo = danhSachTabMo[tab];
                byte[] fileBytesGoc = fileInfo.DuLieuGocBytes ?? fileInfo.DuLieuBytes;
                if (fileBytesGoc == null) continue;

                // Chuyển mảng Byte gốc thành Chuỗi text hệ Nhật Bản Shift-JIS để Regex dò tìm
                string noiDungVanBan = Encoding.GetEncoding("Shift-JIS").GetString(fileBytesGoc);
                Match m = regex.Match(noiDungVanBan);

                if (m.Success)
                {
                    string tenFile = Path.GetFileName(fileInfo.DuongDanFile);

                    // Tính toán vị trí byte thực tế dựa trên vị trí ký tự tìm thấy
                    int viTriKyTu = m.Index;
                    byte[] bytesTruocMatch = Encoding.GetEncoding("Shift-JIS").GetBytes(noiDungVanBan.Substring(0, viTriKyTu));
                    int viTriByteTimThay = bytesTruocMatch.Length;

                    // Tiến hành cắt đuôi hiển thị dữ liệu y hệt như cơ chế Hex của ông
                    int doDaiChuoiTimThay = Encoding.GetEncoding("Shift-JIS").GetByteCount(m.Value);
                    int viTriByteChatDuoi = viTriByteTimThay + doDaiChuoiTimThay;

                    byte[] temporaryBytes = new byte[viTriByteChatDuoi];
                    Array.Copy(fileBytesGoc, 0, temporaryBytes, 0, viTriByteChatDuoi);
                    fileInfo.DuLieuBytes = temporaryBytes;

                    CapNhatDuLieuLenListView(fileInfo.BangHienThi, fileInfo.DuLieuBytes);

                    // Trỏ chuột nhảy thẳng đến dòng chứa kết quả Regex và tô màu xanh lá
                    ListView lv = fileInfo.BangHienThi;
                    if (lv != null && lv.Items.Count > 0)
                    {
                        int rowIndex = viTriByteTimThay / 16;
                        if (rowIndex >= lv.Items.Count) rowIndex = lv.Items.Count - 1;
                        if (rowIndex < 0) rowIndex = 0;

                        lv.Items[rowIndex].Selected = true;
                        lv.Items[rowIndex].Focused = true;
                        lv.Items[rowIndex].BackColor = System.Drawing.Color.LightGreen;
                        lv.Items[rowIndex].EnsureVisible();
                    }

                    GhiLogDieuHuong(tenFile, m.Value);
                    soFileTimThay++;
                }
            }

            GhiLogOutput($"--- Regex完了: {soFileTimThay} 個のファイルが見つかりました。--- \n");
        }

        private void menuChonThuMuc_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog ofd = new OpenFileDialog())
            {
                ofd.ValidateNames = false;
                ofd.CheckFileExists = false;
                ofd.CheckPathExists = true;
                ofd.Filter = "Folders|\n";
                ofd.FileName = "Folder Selection.";

                if (ofd.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        string duongDanThuMucCha = Path.GetDirectoryName(ofd.FileName);
                        if (string.IsNullOrEmpty(duongDanThuMucCha) || !Directory.Exists(duongDanThuMucCha)) return;

                        string[] cacFileTimThay = Directory.GetFiles(duongDanThuMucCha, "*.*", SearchOption.AllDirectories);
                        int count = 0;

                        foreach (string file in cacFileTimThay)
                        {
                            string ext = Path.GetExtension(file).ToLower();
                            if (ext == ".bin" || ext == ".log" || ext == ".txt")
                            {
                                ThemFileVaoTab(file);
                                count++;
                            }
                        }
                        GhiLogOutput($"フォルダ '{Path.GetFileName(duongDanThuMucCha)}' をスキャンし、{count} 個のファイルをタブに読み込みました");
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"フォルダスキャンエラー：{ex.Message}", "エラー");
                    }
                }
            }
        }

        private void button3_Click(object sender, EventArgs e)
        {
            if (tabControlFiles.TabPages.Count == 0)
            {
                GhiLogOutput(" 保存対象の開かれているファイルがありません！");
                return;
            }

            List<TabPage> danhSachTabDaSua = new List<TabPage>();
            foreach (TabPage tab in tabControlFiles.TabPages)
            {
                if (!danhSachTabMo.ContainsKey(tab)) continue;
                ThongTinFileTab fileInfo = danhSachTabMo[tab];

                bool daChinhSua = false;
                try
                {
                    long doDaiFileGoc = new FileInfo(fileInfo.DuongDanFile).Length;
                    if (fileInfo.DuLieuBytes != null && fileInfo.DuLieuBytes.Length != doDaiFileGoc)
                    {
                        daChinhSua = true;
                    }
                }
                catch (Exception) { daChinhSua = true; }

                if (daChinhSua) danhSachTabDaSua.Add(tab);
            }

            if (danhSachTabDaSua.Count == 0)
            {
                MessageBox.Show("保存が必要な変更済みファイルはありません。", "お知らせ", MessageBoxButtons.OK, MessageBoxIcon.Information);
                GhiLogOutput("存処理を停止しました。");
                return;
            }

            GhiLogOutput($"変更されたファイル {danhSachTabDaSua.Count} を検出しました。ファイル選択画面を表示します...");
            List<TabPage> danhSachTabDuocChonXuly = new List<TabPage>();
            using (var hopThoaiChonFile = new HopThoaiChonFileLuuCustom(danhSachTabDaSua))
            {
                if (hopThoaiChonFile.ShowDialog(this) == DialogResult.OK)
                {
                    danhSachTabDuocChonXuly = hopThoaiChonFile.DanhSachTabDuocChon;
                }
                else
                {
                    GhiLogOutput("ファイルの保存処理がキャンセルされました。");
                    return;
                }
            }

            if (danhSachTabDuocChonXuly.Count == 0)
            {
                MessageBox.Show("保存するファイルが選択されていません。", "お知らせ", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            DialogResult cachLuu;
            using (var hopThoaiHoiPhuongThuc = new HopThoaiLuuDuyNhatCustom("保存方法の選択", "保存方法の確認"))
            {
                hopThoaiHoiPhuongThuc.Controls[0].Text = $" 選択された {danhSachTabDuocChonXuly.Count}  個のファイルについて、一括で「上書き保存」しますか？それとも個別に「新規保存」しますか？";
                hopThoaiHoiPhuongThuc.ShowDialog(this);
                cachLuu = hopThoaiHoiPhuongThuc.KetQua;
            }

            if (cachLuu == DialogResult.Cancel)
            {
                GhiLogOutput("上書き/新規保存方法の選択がキャンセルされました。");
                return;
            }

            int thanhCong = 0;
            List<string> tenFileThanhCong = new List<string>();

            if (cachLuu == DialogResult.Yes)
            {
                GhiLogOutput($"一括上書き保存を開始します {danhSachTabDuocChonXuly.Count} file...");
                foreach (TabPage tab in danhSachTabDuocChonXuly)
                {
                    ThongTinFileTab fileInfo = danhSachTabMo[tab];
                    try
                    {
                        File.WriteAllBytes(fileInfo.DuongDanFile, fileInfo.DuLieuBytes);
                        GhiLogOutput($"上書き保存に成功しました: {fileInfo.DuongDanFile}");
                        tenFileThanhCong.Add(Path.GetFileName(fileInfo.DuongDanFile));
                        thanhCong++;
                    }
                    catch (Exception ex) { GhiLogOutput($"上書き保存エラー: {ex.Message}"); }
                }
            }
            else if (cachLuu == DialogResult.No)
            {
                GhiLogOutput($"{danhSachTabDuocChonXuly.Count}のファイルの個別新規保存処理を開始します...");
                foreach (TabPage tab in danhSachTabDuocChonXuly)
                {
                    ThongTinFileTab fileInfo = danhSachTabMo[tab];
                    string tenFileGoc = Path.GetFileName(fileInfo.DuongDanFile);

                    using (SaveFileDialog sfd = new SaveFileDialog())
                    {
                        sfd.Title = $"新規保存エラー: {tenFileGoc}";
                        sfd.FileName = tenFileGoc;
                        sfd.Filter = "Log File|*.bin;*.log;*.txt|All Files|*.*";

                        if (sfd.ShowDialog() == DialogResult.OK)
                        {
                            try
                            {
                                File.WriteAllBytes(sfd.FileName, fileInfo.DuLieuBytes);
                                GhiLogOutput($"新規ファイルの保存に成功しました: {sfd.FileName}");
                                tenFileThanhCong.Add(Path.GetFileName(sfd.FileName) + " (File mới)");
                                thanhCong++;
                            }
                            catch (Exception ex) { GhiLogOutput($"ファイル保存エラー：{ex.Message}"); }
                        }
                    }
                }
            }

            if (thanhCong > 0)
            {
                string chuoiDanhSach = string.Join("\n - ", tenFileThanhCong);
                MessageBox.Show(
                    $"{thanhCong} 個のファイルの保存に成功しました\n\n詳細リスト：\n - {chuoiDanhSach}",
                    "成功", MessageBoxButtons.OK, MessageBoxIcon.Information
                );
            }
        }

        private void XuLyTatTab(TabPage tab)
        {
            if (tab == null || !danhSachTabMo.ContainsKey(tab)) return;

            string tenFile = tab.Text;
            ThongTinFileTab fileInfo = danhSachTabMo[tab];

            bool daChinhSua = false;
            try
            {
                long doDaiFileGoc = new FileInfo(fileInfo.DuongDanFile).Length;
                if (fileInfo.DuLieuBytes != null && fileInfo.DuLieuBytes.Length != doDaiFileGoc)
                {
                    daChinhSua = true;
                }
            }
            catch (Exception) { daChinhSua = true; }

            if (daChinhSua)
            {
                DialogResult confirmDong = MessageBox.Show(
                    $"ファイル'{tenFile}' を閉じてもよろしいですか？",
                    "タブを閉じる確認", MessageBoxButtons.YesNo, MessageBoxIcon.Question
                );

                if (confirmDong == DialogResult.No)
                {
                    GhiLogOutput($"ファイルタブ'{tenFile}', を維持し、クローズ処理をキャンセルしました。");
                    return;
                }

                DialogResult confirmLuu = MessageBox.Show(
                    $"ファイル '{tenFile}' は変更されています！\n閉じる前に変更内容を保存しますか？",
                    "データ保存のお知らせ", MessageBoxButtons.YesNo, MessageBoxIcon.Warning
                );

                if (confirmLuu == DialogResult.Yes)
                {
                    DialogResult cachLuu;
                    using (var hopThoai = new HopThoaiLuuDuyNhatCustom("保存方法の選択", tenFile))
                    {
                        hopThoai.ShowDialog(this);
                        cachLuu = hopThoai.KetQua;
                    }

                    if (cachLuu == DialogResult.Cancel)
                    {
                        GhiLogOutput($"保存方法の選択中に、タブ'{tenFile}' を閉じる処理がキャンセルされました。");
                        return;
                    }

                    if (cachLuu == DialogResult.Yes)
                    {
                        try
                        {
                            File.WriteAllBytes(fileInfo.DuongDanFile, fileInfo.DuLieuBytes);
                            GhiLogOutput($"ファイルを正常に上書き保存しました： {fileInfo.DuongDanFile}");
                        }
                        catch (Exception ex)
                        {
                            MessageBox.Show($"ファイルの上書き保存エラー: {ex.Message}", "エラー");
                            return;
                        }
                    }
                    else if (cachLuu == DialogResult.No)
                    {
                        using (SaveFileDialog sfd = new SaveFileDialog())
                        {
                            sfd.FileName = Path.GetFileName(fileInfo.DuongDanFile);
                            sfd.Filter = "Log File|*.bin;*.log;*.txt|All Files|*.*";

                            if (sfd.ShowDialog() == DialogResult.OK)
                            {
                                try
                                {
                                    File.WriteAllBytes(sfd.FileName, fileInfo.DuLieuBytes);
                                    GhiLogOutput($" 新規ファイルの保存に成功しました: {sfd.FileName}");
                                }
                                catch (Exception ex)
                                {
                                    MessageBox.Show($"ファイル保存エラー：{ex.Message}", "エラー");
                                    return;
                                }
                            }
                            else
                            {
                                GhiLogOutput($"タブのクローズ処理を中断しました。");
                                return;
                            }
                        }
                    }
                }
                else
                {
                    GhiLogOutput($"ァイルの変更内容を保存しない'{tenFile}'.");
                }
            }

            if (listBox1 != null)
            {
                listBox1.Items.Remove(tenFile);
            }

            string duongDanGoc = fileInfo.DuongDanFile;
            danhSachTabMo.Remove(tab);
            tabControlFiles.TabPages.Remove(tab);
            GhiLogOutput($"ファイルタブを完全に閉じました： {duongDanGoc}");
        }

        private void CapNhatDuLieuLenListView(ListView lv, byte[] bytesToDisplay)
        {
            if (lv == null) return;
            lv.BeginUpdate();
            lv.Items.Clear();
            lv.Columns.Clear();
            lv.GridLines = true;
            lv.FullRowSelect = true;

            lv.Columns.Add("Offset", 100);
            lv.Columns.Add("Hex Data", 380);
            lv.Columns.Add("Decoded Text", 200);

            System.Text.Encoding encodingNhat = System.Text.Encoding.GetEncoding("Shift-JIS");
            int bytesPerLine = 16;

            for (int i = 0; i < bytesToDisplay.Length; i += bytesPerLine)
            {
                if (lv.Items.Count >= 5000) break;
                string offsetStr = i.ToString("x8").ToUpper();
                int remainingBytes = Math.Min(bytesPerLine, bytesToDisplay.Length - i);
                byte[] lineBytes = new byte[remainingBytes];
                Array.Copy(bytesToDisplay, i, lineBytes, 0, remainingBytes);

                List<string> hexChunks = new List<string>();
                foreach (byte b in lineBytes) hexChunks.Add(b.ToString("x2").ToUpper());
                string hexStr = string.Join(" ", hexChunks);

                string rawText = encodingNhat.GetString(lineBytes);
                string cleanText = "";
                foreach (char c in rawText) cleanText += (c != '\0' && !char.IsControl(c)) ? c : '.';

                ListViewItem item = new ListViewItem(offsetStr);
                item.SubItems.Add(hexStr);
                item.SubItems.Add(cleanText);
                lv.Items.Add(item);
            }
            lv.EndUpdate();
        }

        private void GhiLogOutput(string noiDung)
        {
            rtbOutput.AppendText(noiDung + "\n");
            rtbOutput.SelectionStart = rtbOutput.Text.Length;
            rtbOutput.ScrollToCaret();
        }

        private void GhiLogDieuHuong(string tenFile, string tuKhoa)
        {
            string tenFileMaHoa = tenFile.Replace(" ", "%20");
            string textHienThi = $"File://{tenFileMaHoa} -> [{tuKhoa}]\n";

            rtbOutput.SelectionColor = System.Drawing.Color.Cyan;
            rtbOutput.AppendText(textHienThi);
            rtbOutput.SelectionColor = rtbOutput.ForeColor;
            rtbOutput.ScrollToCaret();
        }

        private void rtbOutput_LinkClicked(object sender, LinkClickedEventArgs e)
        {
            try
            {
                string linkText = e.LinkText;
                if (!linkText.StartsWith("File://", StringComparison.OrdinalIgnoreCase)) return;

                string tenFileCanPing = linkText.Substring(7).Trim();
                if (tenFileCanPing.Contains(" "))
                {
                    tenFileCanPing = tenFileCanPing.Split(' ')[0].Trim();
                }
                tenFileCanPing = tenFileCanPing.Replace("%20", " ");

                foreach (TabPage tab in tabControlFiles.TabPages)
                {
                    if (tab.Text.Equals(tenFileCanPing, StringComparison.OrdinalIgnoreCase))
                    {
                        tabControlFiles.SelectedTab = tab;
                        return;
                    }
                }
            }
            catch (Exception) { }
        }

        private void tabControlFiles_DrawItem(object sender, DrawItemEventArgs e)
        {
            try
            {
                TabPage tab = tabControlFiles.TabPages[e.Index];
                System.Drawing.Rectangle tabRect = tabControlFiles.GetTabRect(e.Index);

                if (e.State == DrawItemState.Selected)
                {
                    e.Graphics.FillRectangle(System.Drawing.Brushes.White, tabRect);
                }
                else
                {
                    e.Graphics.FillRectangle(System.Drawing.Brushes.LightGray, tabRect);
                }

                System.Drawing.Font fontTab = new System.Drawing.Font("Segoe UI", 9, System.Drawing.FontStyle.Regular);
                e.Graphics.DrawString(tab.Text, fontTab, System.Drawing.Brushes.Black, tabRect.X + 5, tabRect.Y + 4);
                e.Graphics.DrawString("X", fontTab, System.Drawing.Brushes.Red, tabRect.Right - 18, tabRect.Y + 4);
            }
            catch (Exception) { }
        }

        private void tabControlFiles_MouseDown(object sender, MouseEventArgs e)
        {
            for (int i = 0; i < tabControlFiles.TabCount; i++)
            {
                System.Drawing.Rectangle tabRect = tabControlFiles.GetTabRect(i);
                System.Drawing.Rectangle xRect = new System.Drawing.Rectangle(tabRect.Right - 20, tabRect.Y, 20, tabRect.Height);

                if (xRect.Contains(e.Location))
                {
                    XuLyTatTab(tabControlFiles.TabPages[i]);
                    break;
                }
            }
        }

