        private void ThemFileVaoTab(string filePath)
        {
            foreach (var item in danhSachTabMo.Values)
            {
                if (item.DuongDanFile.Equals(filePath, StringComparison.OrdinalIgnoreCase)) return;
            }

            byte[] duLieuFile = File.ReadAllBytes(filePath);
            string tenFile = Path.GetFileName(filePath);
            TabPage tabMoi = new TabPage(tenFile);

            ListView lvMoi = new ListView();
            lvMoi.Dock = DockStyle.Fill;
            lvMoi.View = View.Details;
            lvMoi.Font = new System.Drawing.Font("Consolas", 10F);
            tabMoi.Controls.Add(lvMoi);

            ThongTinFileTab thongTin = new ThongTinFileTab
            {
                DuongDanFile = filePath,
                DuLieuBytes = duLieuFile,
                DuLieuGocBytes = (byte[])duLieuFile.Clone(),
                BangHienThi = lvMoi
            };
            danhSachTabMo.Add(tabMoi, thongTin);

            tabControlFiles.TabPages.Add(tabMoi);
            tabControlFiles.SelectedTab = tabMoi;

            if (listBox1 != null)
            {
                listBox1.Items.Add(tenFile);
            }

            CapNhatDuLieuLenListView(lvMoi, duLieuFile);
            GhiLogOutput($"ファイルを正常に開きました");
        }

        private int NapDanhSachFile(IEnumerable<string> danhSachFile)
        {
            int count = 0;
            foreach (string file in danhSachFile)
            {
                if (!File.Exists(file)) continue;

                string ext = Path.GetExtension(file).ToLower();
                if (ext == ".bin" || ext == ".log" || ext == ".txt")
                {
                    ThemFileVaoTab(file);
                    count++;
                }
            }
            return count;
        }

