    public class SaveSelectionCustomDialog : Form
    {
        private CheckedListBox chkListFiles;
        private List<TabPage> baseTabsList;
        public List<TabPage> SelectedTabs { get; private set; } = new List<TabPage>();

        public SaveSelectionCustomDialog(List<TabPage> modifiedTabsList)
        {
            this.baseTabsList = modifiedTabsList;

            this.Text = "Confirm Target Save Manifest";
            this.Size = new System.Drawing.Size(480, 340);
            this.FormBorderStyle = FormBorderStyle.FixedDialog;
            this.StartPosition = FormStartPosition.CenterParent;
            this.MaximizeBox = false;
            this.MinimizeBox = false;

            Label lblInstruction = new Label();
            lblInstruction.Text = "Detected modified element tracks.\nPlease tick select targets you wish to commit for storage update:";
            lblInstruction.Location = new System.Drawing.Point(15, 15);
            lblInstruction.Size = new System.Drawing.Size(430, 35);
            lblInstruction.Font = new System.Drawing.Font("Segoe UI", 9.5F);
            this.Controls.Add(lblInstruction);

            chkListFiles = new CheckedListBox();
            chkListFiles.Location = new System.Drawing.Point(15, 65);
            chkListFiles.Size = new System.Drawing.Size(435, 180);
            chkListFiles.Font = new System.Drawing.Font("Segoe UI", 10F);
            chkListFiles.CheckOnClick = true;

            foreach (TabPage tab in modifiedTabsList)
            {
                chkListFiles.Items.Add(tab.Text, true);
            }
            this.Controls.Add(chkListFiles);

            Button btnConfirm = new Button();
            btnConfirm.Text = "Confirm";
            btnConfirm.Location = new System.Drawing.Point(190, 255);
            btnConfirm.Size = new System.Drawing.Size(120, 32);
            btnConfirm.Font = new System.Drawing.Font("Segoe UI", 9.5F, System.Drawing.FontStyle.Bold);
            btnConfirm.Click += (s, e) => {
                for (int i = 0; i < chkListFiles.Items.Count; i++)
                {
                    if (chkListFiles.GetItemChecked(i))
                    {
                        SelectedTabs.Add(baseTabsList[i]);
                    }
                }
                this.DialogResult = DialogResult.OK;
                this.Close();
            };
            this.Controls.Add(btnConfirm);

            Button btnCancel = new Button();
            btnCancel.Text = "Cancel";
            btnCancel.Location = new System.Drawing.Point(330, 255);
            btnCancel.Size = new System.Drawing.Size(120, 32);
            btnCancel.Font = new System.Drawing.Font("Segoe UI", 9.5F);
            btnCancel.Click += (s, e) => { this.DialogResult = DialogResult.Cancel; this.Close(); };
            this.Controls.Add(btnCancel);
        }
    }
