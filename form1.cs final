        private void FileListBox_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (fileListBox == null || fileListBox.SelectedItem == null) return;
            string selectedFileName = fileListBox.SelectedItem.ToString();

            if (tabControlFiles != null)
            {
                foreach (TabPage tab in tabControlFiles.TabPages)
                {
                    if (tab.Text == selectedFileName)
                    {
                        tabControlFiles.SelectedTab = tab;

                        if (openedTabs.ContainsKey(tab))
                        {
                            var tabInfo = openedTabs[tab];
                            if (tabInfo.SelectedPingLineIndex >= 0)
                            {
                                NavigateToLine(tabInfo, tabInfo.SelectedPingLineIndex);
                            }
                        }
                        break;
                    }
                }
            }
        }

        private void TabControlFiles_DrawItem(object sender, DrawItemEventArgs e)
        {
            try
            {
                if (tabControlFiles == null || e.Index < 0 || e.Index >= tabControlFiles.TabCount) return;

                TabPage tab = tabControlFiles.TabPages[e.Index];
                Rectangle tabRect = tabControlFiles.GetTabRect(e.Index);

                if (e.State == DrawItemState.Selected)
                    e.Graphics.FillRectangle(Brushes.White, tabRect);
                else
                    e.Graphics.FillRectangle(Brushes.LightGray, tabRect);

                Font fontTab = new Font("Segoe UI", 9, FontStyle.Regular);

                Point textLocation = new Point(tabRect.X + 8, tabRect.Y + 5);
                TextRenderer.DrawText(
                    e.Graphics,
                    tab.Text,
                    fontTab,
                    textLocation,
                    Color.Black,
                    TextFormatFlags.NoClipping
                );

                e.Graphics.DrawString("X", fontTab, Brushes.Red, tabRect.Right - 18, tabRect.Y + 4);
            }
            catch { }
        }

        private void TabControlFiles_MouseDown(object sender, MouseEventArgs e)
        {
            if (tabControlFiles == null) return;
            for (int i = 0; i < tabControlFiles.TabCount; i++)
            {
                Rectangle tabRect = tabControlFiles.GetTabRect(i);

                Rectangle xRect = new Rectangle(tabRect.Right - 20, tabRect.Y, 20, tabRect.Height);
                if (xRect.Contains(e.Location))
                {
                    CloseTabInfo(tabControlFiles.TabPages[i]);
                    break;
                }
            }
        }

        private void CloseTabInfo(TabPage tab)
        {
            if (tab == null || !openedTabs.ContainsKey(tab)) return;

            string fileName = tab.Text;
            if (fileListBox != null) fileListBox.Items.Remove(fileName);
            openedTabs.Remove(tab);
            if (tabControlFiles != null) tabControlFiles.TabPages.Remove(tab);
        }

