        private void TabControlFiles_DrawItem(object sender, DrawItemEventArgs e)
        {
            try
            {
                if (tabControlFiles == null || e.Index < 0 || e.Index >= tabControlFiles.TabCount) return;

                TabPage tab = tabControlFiles.TabPages[e.Index];
                Rectangle tabRect = tabControlFiles.GetTabRect(e.Index);
                bool isSelected = (e.State == DrawItemState.Selected);

                e.Graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;

                Color bgColor = isSelected ? Color.White : Color.FromArgb(235, 238, 242);
                using (Brush bgBrush = new SolidBrush(bgColor))
                {
                    e.Graphics.FillRectangle(bgBrush, tabRect);
                }

                using (Pen sepPen = new Pen(Color.FromArgb(200, 203, 208)))
                {
                    e.Graphics.DrawLine(sepPen, tabRect.Right - 1, tabRect.Y + 6, tabRect.Right - 1, tabRect.Bottom - 6);
                }

                int xWidth = 26;
                Rectangle textAreaRect = new Rectangle(tabRect.X + 8, tabRect.Y, tabRect.Width - xWidth - 8, tabRect.Height);

                using (Region oldClip = e.Graphics.Clip)
                {
                    e.Graphics.SetClip(textAreaRect);

                    using (Font fontTab = new Font("Segoe UI", 9F, isSelected ? FontStyle.Bold : FontStyle.Regular))
                    using (Brush textBrush = new SolidBrush(isSelected ? Color.FromArgb(20, 20, 20) : Color.FromArgb(90, 95, 100)))
                    {
                        using (StringFormat sf = new StringFormat())
                        {
                            sf.Alignment = StringAlignment.Near;
                            sf.LineAlignment = StringAlignment.Center;
                            sf.FormatFlags = StringFormatFlags.NoWrap;

                            e.Graphics.DrawString(tab.Text, fontTab, textBrush, textAreaRect, sf);
                        }

                        int fadeWidth = 35;
                        Rectangle fadeRect = new Rectangle(textAreaRect.Right - fadeWidth, textAreaRect.Y, fadeWidth, textAreaRect.Height);

                        using (var fadeBrush = new System.Drawing.Drawing2D.LinearGradientBrush(
                            fadeRect,
                            Color.FromArgb(0, bgColor),
                            bgColor,
                            System.Drawing.Drawing2D.LinearGradientMode.Horizontal))
                        {
                            e.Graphics.FillRectangle(fadeBrush, fadeRect);
                        }
                    }

                    e.Graphics.Clip = oldClip;
                }

                int xSize = 8;
                int xLeft = tabRect.Right - 18;
                int xTop = tabRect.Y + (tabRect.Height - xSize) / 2;

                Color xColor = isSelected ? Color.FromArgb(80, 80, 80) : Color.FromArgb(160, 160, 160);

                using (Pen xPen = new Pen(xColor, 1.4f))
                {
                    e.Graphics.DrawLine(xPen, xLeft, xTop, xLeft + xSize, xTop + xSize);
                    e.Graphics.DrawLine(xPen, xLeft + xSize, xTop, xLeft, xTop + xSize);
                }
            }
            catch { }
        }

        private void TabControlFiles_MouseDown(object sender, MouseEventArgs e)
        {
            if (tabControlFiles == null) return;
            for (int i = 0; i < tabControlFiles.TabCount; i++)
            {
                Rectangle tabRect = tabControlFiles.GetTabRect(i);

                Rectangle xRect = new Rectangle(tabRect.Right - 20, tabRect.Y, 20, tabRect.Height);
                if (xRect.Contains(e.Location))
                {
                    CloseTabInfo(tabControlFiles.TabPages[i]);
                    break;
                }
            }
        }

        private void CloseTabInfo(TabPage tab)
        {
            if (tab == null || !openedTabs.ContainsKey(tab)) return;

            if (tab == searchingTab)
            {
                searchCts?.Cancel();
                searchingTab = null;
            }

            var tabInfo = openedTabs[tab];
            ReleaseZipTempFolder(tabInfo.TempDirectoryToCleanup);

            if (fileListBox != null) fileListBox.Items.Remove(tab);
            openedTabs.Remove(tab);
            if (tabControlFiles != null) tabControlFiles.TabPages.Remove(tab);

            tab.Dispose();
        }

