        protected override bool ProcessCmdKey(ref Message msg, Keys keyData)
        {
            if (keyData == (Keys.Control | Keys.Z))
            {
                if (this.ActiveControl is TextBox || this.ActiveControl is RichTextBox)
                {
                    return base.ProcessCmdKey(ref msg, keyData);
                }

                ExecuteUndoFind();
                return true;
            }
            return base.ProcessCmdKey(ref msg, keyData);
        }

        private void CleanupOrphanedZipTempFolders()
        {
            try
            {
                string tempRoot = Path.Combine(Path.GetTempPath(), "LogFormatter_ZipTemp");
                if (!Directory.Exists(tempRoot)) return;

                DirectoryInfo rootDir = new DirectoryInfo(tempRoot);
                foreach (DirectoryInfo subDir in rootDir.GetDirectories())
                {
                    if (DateTime.Now - subDir.CreationTime > TimeSpan.FromHours(24))
                    {
                        try { subDir.Delete(true); } catch { }
                    }
                }
            }
            catch { }
        }

        private async void AddFileToTab(string filePath, string zipTempFolder = null)
        {
            if (string.IsNullOrEmpty(filePath) || !File.Exists(filePath)) return;

            string extensionLower = Path.GetExtension(filePath).ToLower();

            if (extensionLower == ".zip")
            {
                await ProcessZipFileAsync(filePath);
                return;
            }

            if (extensionLower != ".log" && extensionLower != ".bin") return;

            foreach (var item in openedTabs.Values)
            {
                if (item.FilePath.Equals(filePath, StringComparison.OrdinalIgnoreCase)) return;
            }

            FileInfo fi = new FileInfo(filePath);
            long fileLength = fi.Length;
            string fileName = fi.Name;

            try
            {
                TabPage newTab = new TabPage(fileName);
                Panel containerPanel = new Panel() { Dock = DockStyle.Fill };

                CustomListView newListView = new CustomListView
                {
                    Dock = DockStyle.Fill,
                    View = View.Details,
                    Font = new Font("Consolas", 10F),
                    GridLines = true,
                    FullRowSelect = true,
                    HideSelection = false
                };

                newListView.Columns.Add("Offset", 110, HorizontalAlignment.Left);
                newListView.Columns.Add("Hex Data", 600, HorizontalAlignment.Left);
                newListView.Columns.Add("Decoded Text", -2, HorizontalAlignment.Left);

                VScrollBar vScroll = new VScrollBar
                {
                    Name = "vScroll",
                    Dock = DockStyle.Right,
                    Minimum = 0,
                    Maximum = VIRTUAL_SCROLL_SCALE,
                    SmallChange = 1,
                    LargeChange = 10
                };

                containerPanel.Controls.Add(newListView);
                containerPanel.Controls.Add(vScroll);
                newTab.Controls.Add(containerPanel);

                FileTabInfo tabInfo = new FileTabInfo
                {
                    FilePath = filePath,
                    OriginalFileLength = fileLength,
                    ActiveFileCutoff = fileLength,
                    DisplayGrid = newListView,
                    VirtualScrollBar = vScroll,
                    TempDirectoryToCleanup = zipTempFolder
                };
                openedTabs.Add(newTab, tabInfo);

                if (!string.IsNullOrEmpty(zipTempFolder))
                {
                    if (zipTempFolderRefCount.ContainsKey(zipTempFolder))
                        zipTempFolderRefCount[zipTempFolder]++;
                    else
                        zipTempFolderRefCount[zipTempFolder] = 1;
                }

                newListView.MouseEnter += (s, e) => {
                    if (!newListView.Focused) newListView.Focus();
                };

                newListView.MouseWheel += (s, e) => {
                    if (!newListView.Focused) newListView.Focus();

                    long totalLines = GetMaxScrollableLineIndex(tabInfo);
                    if (totalLines <= 0) return;

                    int linesDelta = (e.Delta / 120) * 3;
                    long targetLine = tabInfo.CurrentViewStartIndex - linesDelta;

                    if (targetLine < 0) targetLine = 0;
                    if (targetLine > totalLines) targetLine = totalLines;

                    tabInfo.CurrentViewStartIndex = targetLine;

                    int maxScrollVal = vScroll.Maximum - vScroll.LargeChange + 1;
                    double ratio = (double)targetLine / totalLines;
                    vScroll.Value = (int)Math.Min(maxScrollVal, Math.Max(0, ratio * maxScrollVal));

                    RenderVirtualPageStream(tabInfo, targetLine);
                };

                vScroll.Scroll += (s, e) => {
                    long totalLines = GetMaxScrollableLineIndex(tabInfo);
                    if (totalLines <= 0) return;

                    int maxScrollVal = vScroll.Maximum - vScroll.LargeChange + 1;
                    int val = e.NewValue;
                    if (val < vScroll.Minimum) val = vScroll.Minimum;
                    if (val > maxScrollVal) val = maxScrollVal;

                    double ratio = (double)val / maxScrollVal;
                    long targetLine = (long)Math.Floor(ratio * totalLines);

                    tabInfo.CurrentViewStartIndex = targetLine;
                    RenderVirtualPageStream(tabInfo, targetLine);
                };

                newListView.MouseClick += (s, e) => {
                    if (newListView.SelectedIndices.Count > 0)
                    {
                        int selectedIndex = newListView.SelectedIndices[0];
                        tabInfo.SelectedPingLineIndex = tabInfo.CurrentViewStartIndex + selectedIndex;
                        RenderVirtualPageStream(tabInfo, tabInfo.CurrentViewStartIndex);
                    }
                };

                if (tabControlFiles != null)
                {
                    tabControlFiles.TabPages.Add(newTab);
                    tabControlFiles.SelectedTab = newTab;
                }

                if (fileListBox != null)
                {
                    fileListBox.Items.Add(newTab);
                }

                RenderVirtualPageStream(tabInfo, 0);
                WriteOutputLog($"Opened: {fileName}");
            }
            catch (Exception ex)
            {
                WriteOutputLog($"Open error for '{fileName}': {ex.Message}");
            }
        }

        private void RenderVirtualPageStream(FileTabInfo tabInfo, long startIndex)
        {
            if (tabInfo == null || tabInfo.DisplayGrid == null || !File.Exists(tabInfo.FilePath)) return;

            ListView lv = tabInfo.DisplayGrid;
            lv.BeginUpdate();
            lv.Items.Clear();

            try
            {
                long startByteOffset = startIndex * BYTES_PER_LINE;
                if (startByteOffset >= tabInfo.ActiveFileCutoff)
                {
                    lv.EndUpdate();
                    return;
                }

                long totalBytesToRead = (long)MAX_DISPLAY_LINES * BYTES_PER_LINE;
                if (startByteOffset + totalBytesToRead > tabInfo.ActiveFileCutoff)
                {
                    totalBytesToRead = tabInfo.ActiveFileCutoff - startByteOffset;
                }

                byte[] bigBuffer = new byte[totalBytesToRead];
                int totalBytesRead = 0;

                using (FileStream fs = new FileStream(tabInfo.FilePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                {
                    fs.Seek(startByteOffset, SeekOrigin.Begin);
                    totalBytesRead = fs.Read(bigBuffer, 0, (int)totalBytesToRead);
                }

                int bytesProcessed = 0;
                int lineCount = 0;

                while (bytesProcessed < totalBytesRead && lineCount < MAX_DISPLAY_LINES)
                {
                    long currentLineIndex = startIndex + lineCount;
                    long exactLineOffset = startByteOffset + bytesProcessed;

                    int currentLineBytes = (int)Math.Min((long)BYTES_PER_LINE, totalBytesRead - bytesProcessed);

                    byte[] lineBuffer = new byte[currentLineBytes];
                    Buffer.BlockCopy(bigBuffer, bytesProcessed, lineBuffer, 0, currentLineBytes);

                    string offsetStr = exactLineOffset.ToString("X8");

                    List<string> hexChunks = new List<string>();
                    for (int k = 0; k < currentLineBytes; k++) hexChunks.Add(lineBuffer[k].ToString("X2"));
                    string hexStr = string.Join(" ", hexChunks);

                    string rawText = ShiftJisEncoding.GetString(lineBuffer, 0, currentLineBytes);

                    char[] cleanChars = new char[rawText.Length];
                    for (int cIdx = 0; cIdx < rawText.Length; cIdx++)
                    {
                        char c = rawText[cIdx];
                        cleanChars[cIdx] = (c != '\0' && !char.IsControl(c)) ? c : '.';
                    }
                    string cleanText = new string(cleanChars);

                    ListViewItem item = new ListViewItem(offsetStr);
                    item.SubItems.Add(hexStr);
                    item.SubItems.Add(cleanText);

                    if (tabInfo.SelectedPingLineIndex != -1 && currentLineIndex == tabInfo.SelectedPingLineIndex)
                    {
                        item.Selected = true;
                        item.Focused = true;
                        item.BackColor = Color.Yellow;
                        item.ForeColor = Color.Black;
                    }

                    lv.Items.Add(item);

                    bytesProcessed += currentLineBytes;
                    lineCount++;
                }
            }
            catch (Exception ex)
            {
                WriteOutputLog($"Render error: {ex.Message}");
            }

            lv.EndUpdate();
        }

        private long GetMaxScrollableLineIndex(FileTabInfo tabInfo)
        {
            if (tabInfo == null || tabInfo.ActiveFileCutoff <= 0) return 0;
            long totalFileLines = (long)Math.Ceiling((double)tabInfo.ActiveFileCutoff / BYTES_PER_LINE);
            return Math.Max(0, totalFileLines - 1);
        }

        private async Task ProcessZipFileAsync(string zipFilePath)
        {
            if (Interlocked.Increment(ref activeZipTasks) == 1)
            {
                this.Cursor = Cursors.WaitCursor;
            }

            string zipName = Path.GetFileName(zipFilePath);
            WriteOutputLog($"Extracting '{zipName}' (0%)...");

            try
            {
                string tempFolder = Path.Combine(Path.GetTempPath(), "LogFormatter_ZipTemp", Guid.NewGuid().ToString("N"));

                var progress = new Progress<int>(percent =>
                {
                    WriteOutputLog($"Extracting '{zipName}' progress: {percent}%");
                });

                var targetFiles = await Task.Run(() =>
                {
                    Directory.CreateDirectory(tempFolder);
                    var extractedFiles = new List<FileInfo>();

                    using (ZipArchive archive = ZipFile.OpenRead(zipFilePath))
                    {
                        long totalBytes = archive.Entries
                            .Where(e => !string.IsNullOrEmpty(e.Name) &&
                                       (Path.GetExtension(e.Name).Equals(".log", StringComparison.OrdinalIgnoreCase) ||
                                        Path.GetExtension(e.Name).Equals(".bin", StringComparison.OrdinalIgnoreCase)))
                            .Sum(e => e.Length);

                        long extractedBytes = 0;
                        int lastReportedPercent = -1;

                        foreach (ZipArchiveEntry entry in archive.Entries)
                        {
                            if (string.IsNullOrEmpty(entry.Name)) continue;

                            string entryExt = Path.GetExtension(entry.Name).ToLower();
                            if (entryExt != ".log" && entryExt != ".bin") continue;

                            string safeName = Path.GetFileName(entry.Name);
                            string destinationPath = Path.Combine(tempFolder, Guid.NewGuid().ToString("N") + "_" + safeName);

                            string fullTempPath = Path.GetFullPath(tempFolder);
                            string fullDestPath = Path.GetFullPath(destinationPath);
                            if (!fullDestPath.StartsWith(fullTempPath, StringComparison.OrdinalIgnoreCase))
                            {
                                throw new Exception("Security Error: Zip Slip detected.");
                            }

                            entry.ExtractToFile(destinationPath, true);
                            extractedFiles.Add(new FileInfo(destinationPath));

                            extractedBytes += entry.Length;

                            if (totalBytes > 0)
                            {
                                int currentPercent = (int)(((double)extractedBytes / totalBytes) * 100);
                                if (currentPercent - lastReportedPercent >= 10 || currentPercent == 100)
                                {
                                    lastReportedPercent = currentPercent;
                                    ((IProgress<int>)progress).Report(currentPercent);
                                }
                            }
                        }
                    }
                    return extractedFiles;
                });

                if (targetFiles.Count == 0)
                {
                    WriteOutputLog($"No log files in '{zipName}'.");
                    try { Directory.Delete(tempFolder, true); } catch { }
                    return;
                }

                foreach (FileInfo fileInfo in targetFiles)
                {
                    AddFileToTab(fileInfo.FullName, tempFolder);
                }
            }
            catch (Exception ex)
            {
                WriteOutputLog($"ZIP error: {ex.Message}");
            }
            finally
            {
                if (Interlocked.Decrement(ref activeZipTasks) == 0)
                {
                    this.Cursor = Cursors.Default;
                }
            }
        }

        private async void ExecuteSafeFolderScan()
        {
            using (var dialog = new CommonOpenFileDialog())
            {
                dialog.IsFolderPicker = true;
                dialog.Title = "Choose Folder";
                dialog.EnsurePathExists = true;

                if (dialog.ShowDialog() == CommonFileDialogResult.Ok)
                {
                    try
                    {
                        string targetDirectory = dialog.FileName;

                        if (!string.IsNullOrEmpty(targetDirectory) && Directory.Exists(targetDirectory))
                        {
                            this.Cursor = Cursors.WaitCursor;

                            List<FileInfo> filteredFiles = await Task.Run(() =>
                            {
                                DirectoryInfo di = new DirectoryInfo(targetDirectory);
                                string[] searchPatterns = { "*.log", "*.bin", "*.zip" };
                                List<FileInfo> files = new List<FileInfo>();

                                foreach (string pattern in searchPatterns)
                                {
                                    files.AddRange(di.EnumerateFiles(pattern, SearchOption.AllDirectories));
                                }
                                return files;
                            });

                            if (filteredFiles.Count == 0)
                            {
                                WriteOutputLog($"No files in '{targetDirectory}'.");
                                return;
                            }

                            foreach (FileInfo fileInfo in filteredFiles)
                            {
                                AddFileToTab(fileInfo.FullName);
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show(ex.Message, "Error");
                    }
                    finally
                    {
                        this.Cursor = Cursors.Default;
                    }
                }
            }
        }

        private void RevertButton_Click(object sender, EventArgs e)
        {
            if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
            TabPage currentTab = tabControlFiles.SelectedTab;
            if (!openedTabs.ContainsKey(currentTab)) return;
            var tabInfo = openedTabs[currentTab];

            if (currentTab == searchingTab)
            {
                MessageBox.Show("Search is currently running on this tab.", "Busy", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            tabInfo.ActiveFileCutoff = tabInfo.OriginalFileLength;
            tabInfo.CutoffHistory.Clear();
            tabInfo.SelectedPingLineIndex = -1;
            tabInfo.CurrentViewStartIndex = 0;

            if (tabInfo.VirtualScrollBar != null) tabInfo.VirtualScrollBar.Value = 0;

            RenderVirtualPageStream(tabInfo, 0);
            WriteOutputLog($"Reverted: '{Path.GetFileName(tabInfo.FilePath)}' restored to original length ({tabInfo.OriginalFileLength} bytes).", appendExtraSpace: true);
        }

        private void UndoFindButton_Click(object sender, EventArgs e)
        {
            ExecuteUndoFind();
        }

        private void ExecuteUndoFind()
        {
            if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
            TabPage currentTab = tabControlFiles.SelectedTab;
            if (!openedTabs.ContainsKey(currentTab)) return;
            var tabInfo = openedTabs[currentTab];

            if (currentTab == searchingTab)
            {
                MessageBox.Show("Search is currently running on this tab.", "Busy", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            if (tabInfo.CutoffHistory.Count == 0)
            {
                WriteOutputLog("No search history to undo.", appendExtraSpace: true);
                return;
            }

            tabInfo.ActiveFileCutoff = tabInfo.CutoffHistory.Pop();
            tabInfo.SelectedPingLineIndex = -1;

            long maxLineIndex = GetMaxScrollableLineIndex(tabInfo);
            if (tabInfo.CurrentViewStartIndex > maxLineIndex)
            {
                tabInfo.CurrentViewStartIndex = Math.Max(0, maxLineIndex);
            }

            if (tabInfo.VirtualScrollBar != null && maxLineIndex > 0)
            {
                int maxScrollVal = tabInfo.VirtualScrollBar.Maximum - tabInfo.VirtualScrollBar.LargeChange + 1;
                double ratio = (double)tabInfo.CurrentViewStartIndex / maxLineIndex;
                tabInfo.VirtualScrollBar.Value = (int)Math.Min(maxScrollVal, Math.Max(0, ratio * maxScrollVal));
            }

            RenderVirtualPageStream(tabInfo, tabInfo.CurrentViewStartIndex);
            WriteOutputLog("Restored", appendExtraSpace: true);
        }

        private void SaveButton_Click(object sender, EventArgs e)
        {
            if (searchingTab != null)
            {
                MessageBox.Show("Search in progress. Please wait or cancel first.", "Busy", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            var modifiedTabs = openedTabs.Values.Where(t => t.ActiveFileCutoff != t.OriginalFileLength).ToList();
            if (modifiedTabs.Count == 0)
            {
                MessageBox.Show("No edited files to save.", "Notification", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            ExecuteSaveWorkflow(modifiedTabs);
        }

        private bool ExecuteSaveWorkflow(List<FileTabInfo> targetTabs)
        {
            if (targetTabs == null || targetTabs.Count == 0) return true;

            using (SaveModeDialog modeDlg = new SaveModeDialog())
            {
                if (modeDlg.ShowDialog(this) != DialogResult.OK || modeDlg.UserChoice == SaveModeDialog.SaveChoice.Cancel)
                {
                    return false;
                }

                bool requestedOverwrite = (modeDlg.UserChoice == SaveModeDialog.SaveChoice.SaveOverwrite);

                foreach (var tabInfo in targetTabs)
                {
                    string currentFileName = Path.GetFileName(tabInfo.FilePath);
                    try
                    {
                        string targetPath = tabInfo.FilePath;
                        bool isZipExtractedFile = !string.IsNullOrEmpty(tabInfo.TempDirectoryToCleanup);
                        bool isOverwrite = requestedOverwrite;

                        if (isZipExtractedFile && isOverwrite)
                        {
                            MessageBox.Show($"'{currentFileName}' is from ZIP. Overwrite disallowed.\nPlease select Save As location.",
                                "Save Action Redirected", MessageBoxButtons.OK, MessageBoxIcon.Information);
                            isOverwrite = false;
                        }

                        if (!isOverwrite)
                        {
                            using (SaveFileDialog sfd = new SaveFileDialog())
                            {
                                sfd.Title = $"Save As - {currentFileName}";
                                sfd.Filter = "Log Files (*.log)|*.log|Bin Files (*.bin)|*.bin|All Files (*.*)|*.*";
                                sfd.InitialDirectory = isZipExtractedFile ? Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments) : Path.GetDirectoryName(tabInfo.FilePath);
                                sfd.FileName = Path.GetFileNameWithoutExtension(tabInfo.FilePath) + "_trimmed" + Path.GetExtension(tabInfo.FilePath);

                                if (sfd.ShowDialog(this) == DialogResult.OK)
                                {
                                    targetPath = sfd.FileName;
                                }
                                else
                                {
                                    continue;
                                }
                            }
                        }

                        string tempPath = targetPath + ".tmp";
                        using (FileStream src = new FileStream(tabInfo.FilePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                        using (FileStream dst = new FileStream(tempPath, FileMode.Create, FileAccess.Write))
                        {
                            byte[] buffer = new byte[64 * 1024];
                            long bytesLeft = tabInfo.ActiveFileCutoff;
                            long totalToSave = bytesLeft;
                            int lastReportedPercent = 0;

                            while (bytesLeft > 0)
                            {
                                int read = src.Read(buffer, 0, (int)Math.Min(buffer.Length, bytesLeft));
                                if (read <= 0) break;
                                dst.Write(buffer, 0, read);
                                bytesLeft -= read;

                                if (totalToSave > 0)
                                {
                                    int currentPercent = (int)(((totalToSave - bytesLeft) / (double)totalToSave) * 100);
                                    if (currentPercent - lastReportedPercent >= 25 || currentPercent == 100)
                                    {
                                        lastReportedPercent = currentPercent;
                                        WriteOutputLog($"Saving '{currentFileName}' progress: {currentPercent}%");
                                    }
                                }
                            }
                        }

                        TabPage activeTabKey = openedTabs.FirstOrDefault(x => x.Value == tabInfo).Key;
                        string newFileName = Path.GetFileName(targetPath);

                        if (isOverwrite)
                        {
                            File.Delete(tabInfo.FilePath);
                            File.Move(tempPath, tabInfo.FilePath);
                            tabInfo.OriginalFileLength = tabInfo.ActiveFileCutoff;
                            tabInfo.CutoffHistory.Clear();
                            WriteOutputLog($"Saved: {newFileName}");
                        }
                        else
                        {
                            if (File.Exists(targetPath)) File.Delete(targetPath);
                            File.Move(tempPath, targetPath);

                            if (isZipExtractedFile)
                            {
                                ReleaseZipTempFolder(tabInfo.TempDirectoryToCleanup);
                                tabInfo.TempDirectoryToCleanup = null;
                            }

                            tabInfo.FilePath = targetPath;
                            tabInfo.OriginalFileLength = tabInfo.ActiveFileCutoff;
                            tabInfo.CutoffHistory.Clear();

                            if (activeTabKey != null)
                            {
                                activeTabKey.Text = newFileName;
                            }

                            if (fileListBox != null)
                            {
                                int itemIdx = fileListBox.Items.IndexOf(activeTabKey);
                                if (itemIdx >= 0)
                                {
                                    fileListBox.Items[itemIdx] = activeTabKey;
                                }
                            }

                            WriteOutputLog($"Saved as: {targetPath}");
                        }
                    }
                    catch (Exception ex)
                    {
                        WriteOutputLog($"Save failed for {currentFileName}: {ex.Message}");
                    }
                }

                return true;
            }
        }

        private void Form1_FormClosing(object sender, FormClosingEventArgs e)
        {
            var modifiedList = openedTabs.Values.Where(t => t.ActiveFileCutoff != t.OriginalFileLength).ToList();
            if (modifiedList.Count > 0)
            {
                var result = MessageBox.Show($"You have {modifiedList.Count} edited file(s). Save before exit?", "Unsaved Changes", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question);
                if (result == DialogResult.Yes)
                {
                    if (!ExecuteSaveWorkflow(modifiedList)) e.Cancel = true;
                }
                else if (result == DialogResult.Cancel)
                {
                    e.Cancel = true;
                }
            }

            foreach (var tabInfo in openedTabs.Values.ToList())
            {
                ReleaseZipTempFolder(tabInfo.TempDirectoryToCleanup);
            }
        }

        private void ReleaseZipTempFolder(string folderPath)
        {
            if (!string.IsNullOrEmpty(folderPath) && zipTempFolderRefCount.ContainsKey(folderPath))
            {
                zipTempFolderRefCount[folderPath]--;
                if (zipTempFolderRefCount[folderPath] <= 0)
                {
                    zipTempFolderRefCount.Remove(folderPath);
                    if (Directory.Exists(folderPath))
                    {
                        try { Directory.Delete(folderPath, true); } catch { }
                    }
                }
            }
        }

        private bool ParseInputToBytePattern(string input, out List<byte?> pattern)
        {
            pattern = new List<byte?>();

            if (string.IsNullOrWhiteSpace(input)) return false;

            string raw = input.Trim();
            string[] tokens = raw.Split(new[] { ' ', ',' }, StringSplitOptions.RemoveEmptyEntries);

            bool containsExplicitWildcards = tokens.Any(t => t == "??" || t == "?" || t == ".." || t == "*");
            bool isMultiTokenHex = tokens.Length > 1 && tokens.All(t =>
                t == "??" || t == "?" || t == ".." || t == "*" || byte.TryParse(t, System.Globalization.NumberStyles.HexNumber, null, out _));

            if (containsExplicitWildcards || isMultiTokenHex)
            {
                List<byte?> hexPattern = new List<byte?>();
                bool parseSuccess = true;

                foreach (var token in tokens)
                {
                    if (token == "??" || token == "?" || token == ".." || token == "*")
                    {
                        hexPattern.Add(null);
                    }
                    else if (byte.TryParse(token, System.Globalization.NumberStyles.HexNumber, null, out byte b))
                    {
                        hexPattern.Add(b);
                    }
                    else
                    {
                        parseSuccess = false;
                        break;
                    }
                }

                if (parseSuccess && hexPattern.Count > 0)
                {
                    pattern = hexPattern;
                    return true;
                }
            }

            pattern.Clear();
            byte[] textBytes = ShiftJisEncoding.GetBytes(raw);
            foreach (byte b in textBytes)
            {
                pattern.Add(b);
            }

            return pattern.Count > 0;
        }

        private async void FindButton_Click(object sender, EventArgs e)
        {
            if (searchTextBox == null || string.IsNullOrWhiteSpace(searchTextBox.Text))
            {
                WriteOutputLog("Warning: Search pattern is empty.", appendExtraSpace: true);
                return;
            }

            if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
            TabPage currentTab = tabControlFiles.SelectedTab;

            if (!openedTabs.ContainsKey(currentTab)) return;
            var tabInfo = openedTabs[currentTab];

            string rawInput = searchTextBox.Text.Trim();

            searchCts?.Cancel();
            searchCts = new CancellationTokenSource();
            searchingTab = currentTab;

            Control btn = (Control)sender;
            if (btn != null) btn.Enabled = false;

            if (!ParseInputToBytePattern(rawInput, out List<byte?> targetPattern))
            {
                WriteOutputLog($"Error: Invalid input pattern '{rawInput}'.", appendExtraSpace: true);
                if (btn != null) btn.Enabled = true;
                searchingTab = null;
                return;
            }

            tabInfo.CurrentSearchKeyword = rawInput;
            string fileName = Path.GetFileName(tabInfo.FilePath);

            WriteOutputLog($"Searching for '{rawInput}' in [{fileName}] (0%)...");

            try
            {
                long? newCutoffFound = null;

                var progress = new Progress<int>(percent =>
                {
                    WriteOutputLog($"Scanning [{fileName}] progress: {percent}%");
                });

                var searchResults = await Task.Run(() =>
                {
                    var results = new List<SearchResultItem>();
                    long activeSearchLength = tabInfo.ActiveFileCutoff;
                    const int BUFFER_SIZE = 8 * 1024 * 1024;
                    int patternLen = targetPattern.Count;

                    using (FileStream fs = new FileStream(tabInfo.FilePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                    {
                        byte[] chunkBuffer = new byte[BUFFER_SIZE];
                        long filePosition = activeSearchLength;
                        int lastReportedPercent = 0;

                        while (filePosition > 0)
                        {
                            searchCts.Token.ThrowIfCancellationRequested();

                            int bytesToRead = (int)Math.Min(BUFFER_SIZE, filePosition);
                            long chunkStartOffset = filePosition - bytesToRead;

                            fs.Seek(chunkStartOffset, SeekOrigin.Begin);
                            int bytesRead = fs.Read(chunkBuffer, 0, bytesToRead);
                            if (bytesRead <= 0) break;

                            for (int i = bytesRead - patternLen; i >= 0; i--)
                            {
                                bool match = true;
                                for (int j = 0; j < patternLen; j++)
                                {
                                    if (targetPattern[j].HasValue && chunkBuffer[i + j] != targetPattern[j].Value)
                                    {
                                        match = false;
                                        break;
                                    }
                                }

                                if (match)
                                {
                                    long matchAbsoluteOffset = chunkStartOffset + i;
                                    long matchEndOffset = matchAbsoluteOffset + patternLen;

                                    newCutoffFound = matchEndOffset;

                                    long matchLineIndex = matchAbsoluteOffset / BYTES_PER_LINE;
                                    long lineStartOffset = matchLineIndex * BYTES_PER_LINE;

                                    byte[] lineBuffer = new byte[BYTES_PER_LINE];
                                    fs.Seek(lineStartOffset, SeekOrigin.Begin);
                                    int lineBytesRead = fs.Read(lineBuffer, 0, BYTES_PER_LINE);

                                    List<string> hexChunks = new List<string>();
                                    for (int k = 0; k < lineBytesRead; k++) hexChunks.Add(lineBuffer[k].ToString("X2"));

                                    results.Add(new SearchResultItem
                                    {
                                        LineIndex = matchLineIndex,
                                        Offset = lineStartOffset.ToString("X8"),
                                        HexData = string.Join(" ", hexChunks),
                                        DecodedText = ShiftJisEncoding.GetString(lineBuffer, 0, lineBytesRead),
                                        MatchedInHex = true
                                    });

                                    break;
                                }
                            }

                            if (results.Count > 0) break;
                            if (chunkStartOffset <= 0) break;

                            filePosition = chunkStartOffset + (patternLen - 1);

                            if (activeSearchLength > 0)
                            {
                                double scanned = activeSearchLength - filePosition;
                                int currentPercent = (int)((scanned / activeSearchLength) * 100);
                                if (currentPercent - lastReportedPercent >= 10)
                                {
                                    lastReportedPercent = currentPercent;
                                    ((IProgress<int>)progress).Report(currentPercent);
                                }
                            }
                        }
                    }

                    return results;
                }, searchCts.Token);

                if (!openedTabs.ContainsKey(currentTab)) return;

                if (searchResults.Count == 0)
                {
                    WriteOutputLog($"Scanning [{fileName}] progress: 100%");
                    WriteOutputLog($"No match found for '{rawInput}'.", appendExtraSpace: true);
                    return;
                }

                if (newCutoffFound.HasValue)
                {
                    tabInfo.CutoffHistory.Push(tabInfo.ActiveFileCutoff);
                    tabInfo.ActiveFileCutoff = newCutoffFound.Value;
                }

                if (rtbOutput != null)
                {
                    WriteOutputLog($"[Offset:{searchResults[0].Offset}] {searchResults[0].HexData}", appendExtraSpace: true);
                }

                NavigateToLine(tabInfo, searchResults[0].LineIndex);
            }
            catch (OperationCanceledException)
            {
                WriteOutputLog("Search cancelled.", appendExtraSpace: true);
            }
            catch (Exception ex)
            {
                WriteOutputLog($"Search error: {ex.Message}", appendExtraSpace: true);
            }
            finally
            {
                if (btn != null) btn.Enabled = true;
                if (searchingTab == currentTab) searchingTab = null;
            }
        }

        private void NavigateToLine(FileTabInfo tabInfo, long targetLineIndex)
        {
            tabInfo.SelectedPingLineIndex = targetLineIndex;
            tabInfo.CurrentViewStartIndex = Math.Max(0, targetLineIndex - 2);

            long totalLines = GetMaxScrollableLineIndex(tabInfo);
            if (tabInfo.VirtualScrollBar != null && totalLines > 0)
            {
                int maxScrollVal = tabInfo.VirtualScrollBar.Maximum - tabInfo.VirtualScrollBar.LargeChange + 1;
                double ratio = (double)tabInfo.CurrentViewStartIndex / totalLines;
                tabInfo.VirtualScrollBar.Value = (int)Math.Min(maxScrollVal, Math.Max(0, ratio * maxScrollVal));
            }

            RenderVirtualPageStream(tabInfo, tabInfo.CurrentViewStartIndex);
        }

        private void RtbOutput_MouseClick(object sender, MouseEventArgs e)
        {
            if (rtbOutput == null || string.IsNullOrEmpty(rtbOutput.Text)) return;

            try
            {
                int charIndex = rtbOutput.GetCharIndexFromPosition(e.Location);
                int lineIndex = rtbOutput.GetLineFromCharIndex(charIndex);
                if (lineIndex < 0 || lineIndex >= rtbOutput.Lines.Length) return;

                string currentLineText = rtbOutput.Lines[lineIndex];

                Match m = Regex.Match(currentLineText, @"\[Offset:([0-9A-Fa-f]+)\]");

                if (m.Success)
                {
                    string hexOffsetStr = m.Groups[1].Value;
                    long byteOffset = Convert.ToInt64(hexOffsetStr, 16);

                    long targetLineIndex = byteOffset / BYTES_PER_LINE;

                    if (tabControlFiles == null || tabControlFiles.SelectedTab == null) return;
                    TabPage currentTab = tabControlFiles.SelectedTab;
                    if (!openedTabs.ContainsKey(currentTab)) return;
                    var tabInfo = openedTabs[currentTab];

                    NavigateToLine(tabInfo, targetLineIndex);
                }
            }
            catch (Exception ex)
            {
                WriteOutputLog($"Nav error: {ex.Message}");
            }
        }

        private void WriteOutputLog(string content, bool appendExtraSpace = false)
        {
            if (rtbOutput == null) return;
            if (rtbOutput.InvokeRequired)
            {
                rtbOutput.BeginInvoke(new Action<string, bool>(WriteOutputLog), content, appendExtraSpace);
                return;
            }

            Color msgColor = Color.LightGray;
            if (content.Contains("[Folder Scan]") || content.Contains("Opened") || content.Contains("Saved") || content.Contains("Offset:") || content.Contains("Extracting") || content.Contains("Reverted"))
            {
                msgColor = Color.LimeGreen;
            }
            else if (content.IndexOf("error", StringComparison.OrdinalIgnoreCase) >= 0
                  || content.IndexOf("failed", StringComparison.OrdinalIgnoreCase) >= 0
                  || content.IndexOf("disallowed", StringComparison.OrdinalIgnoreCase) >= 0
                  || content.IndexOf("warning", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                msgColor = Color.Tomato;
            }

            rtbOutput.SelectionStart = rtbOutput.Text.Length;
            rtbOutput.SelectionLength = 0;

            rtbOutput.SelectionColor = Color.Gray;
            rtbOutput.AppendText($"[{DateTime.Now:HH:mm:ss}] ");
            rtbOutput.SelectionColor = msgColor;

            string lineEnd = appendExtraSpace ? "\n\n\n" : "\n";
            rtbOutput.AppendText(content + lineEnd);

            rtbOutput.ScrollToCaret();
        }

