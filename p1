													if (g_Base.Stg.Nml.SubANmlZenchouShisaShubetsuTyp = E_SUBA_NML_ZENCHOU_SHISA_SHUBETSU_2) {
														//YES
														//当該の主ｲﾍﾞﾝﾄ[MNL_前兆示唆消去]=1?
														if (GET_EVT_TABLE_ATTR(SubA_PrjCmn_GetEventMain(), D_EVT_NML_ZEN_SISA_DELE) == 1) {
															//YES
															//[前兆示唆種別]←3
															g_Base.Stg.Nml.SubANmlZenchouShisaShubetsuTyp == 3;
														}
														else {
															//NO
															//副_先ﾊﾞﾚ
															SubA_PrjCmn_SubLotFunc_GetEvent(D_LOT_E_NML_FUKU_SAKI_BARE);
														}

													}
													else {
														//NO
														//[前兆種別]≧6且つ前遊技_[前兆種別]≦3?
														if (g_Base.Stg.Nml.SubANmlZenchouShisaShubetsuTyp >= 6 && g_Base.Stg.Nml.SubANmlZenchouShisaShubetsuTyp <= 3) {
															//NO
															//当該の主ｲﾍﾞﾝﾄ[NML_途中前兆開始]=1?
															if (SubA_PrjCmn_GetAttrData(SubA_PrjCmn_GetEventMain(), D_EVT_NML_ZEN_SISA_DELE) == 1) {
																//NO
																//[ｻﾌﾞﾌﾗｸﾞ]=9or14or15? 
																if (g_Base.Cmn.Pr.SubFlag == D_SUB_FLAG_K_CHE ||
																	g_Base.Cmn.Pr.SubFlag == D_SUB_FLAG_KCHA1 ||
																	g_Base.Cmn.Pr.SubFlag == D_SUB_FLAG_KCHA2) {
																	//NO
																	//[前兆種別]≧6且つ[前兆進行G] = 1且つ[ｽﾃｰｼﾞ] = 4 / 5且つ[ｻﾌﾞﾌﾗｸﾞ]≧8 ?
																	if (g_Base.Stg.Nml.SubANmlZenTyp >= E_SUBA_NML_ZEN_TYP_CZC &&
																		g_Base.Stg.Nml.SubANmlZenPrgG == 1 &&
																		g_Base.Stg.Nml.SubANmlStgNow == 4 / 5 &&
																		g_Base.Cmn.Pr.SubFlag >= D_SUB_FLAG_J_CHE) {
																	}
																}
															}
														}
														else {
															//YES
															//[ｻﾌﾞﾌﾗｸﾞ] ≧8 ?
															if (g_Base.Cmn.Pr.SubFlag >= D_SUB_FLAG_J_CHE) {
																//YES
																//[前兆示唆種別]←1
																g_Base.Stg.Nml.SubANmlZenchouShisaShubetsuTyp == 1;

																//前兆示唆色抽せん
																result = SubA_PrjCmn_SubLotFunc_GetEvent(D_LOT_E_CZ_FUK_CHAN);
																//[前兆示唆色]←結果
																g_Base.Stg.Nml.SubANmlZenchouShisaIroTyp = result;

																//副_前兆示唆出現
																SubA_PrjCmn_SubLotFunc_GetEvent(D_LOT_E_NML_FUK_ZENCHOU_SHISA_SHUTSUGEN);

																//副_先ﾊﾞﾚ
																SubA_PrjCmn_SubLotFunc_GetEvent(D_LOT_E_NML_FUKU_SAKI_BARE);
															}
														}

													}
												}
											}


										}
									}
								}
							}
						}
					}
				}
			}
