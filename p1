					g_Base.Stg.Nml.SubANmlZenZanG = g_Base.Stg.Nml.SubANmlUraZenZanG;

					//[前兆進行G]←[裏前兆進行G]
					g_Base.Stg.Nml.SubANmlZenPrgG = g_Base.Stg.Nml.SubANmlUraZenPrgG;

					//前兆種別抽せん_裏前兆
					SubA_PrjCmn_SubLotFunc_GetEtcLot(D_LOT_O_NML_ZEN_TYP_URA_STG);
					//結果=0?
					if (result == 0) {
						//YES
						//[前兆全体G]←0
						g_Base.Stg.Nml.SubANmlZenAllG = 0;
						//[前兆残G]←0
						g_Base.Stg.Nml.SubANmlZenZanG = 0;
						//[前兆進行G]←0
						g_Base.Stg.Nml.SubANmlZenPrgG = 0;
					}
					else {
						//NO
						//[前兆種別]←結果
						g_Base.Stg.Nml.SubANmlZenTyp = (E_SUBA_NML_ZEN_TYP)result;
						//[ﾌﾞﾛｯｸ状況]←1
						g_Base.Stg.Nml.SubANmlBlkSts = 1;
						//[起点役]←[裏起点役]
						g_Base.Stg.Nml.SubANmlKitYak = g_Base.Stg.Nml.SubANmlUraKitYak;

						//前兆強度抽せん_通常ｽﾃ
						result = SubA_PrjCmn_SubLotFunc_GetEtcLot(D_LOT_O_NM_ZENCHOU_SHU);
						//[前兆強度_種別] ←結果
						g_Base.Stg.Nml.SubANmlZKS_Typ = result;

						//ｽﾃﾁｪﾝ予約抽せん
						result = SubA_PrjCmn_SubLotFunc_GetEtcLot(D_LOT_O_NML_STG_CHG_YOY);
						//[ｽﾃﾁｪﾝ予約] ←結果
						g_Base.Stg.Nml.SubANmlStgChgYoy = result;

						//結果=65535?(ｴﾗｰ)
						if (result == 65535) {
							//YES
								//アサート
						}
						else {
							//NO
							//【当該出玉状態】=ZEN or 【次回出玉状態】= GMA/CZ?
							if (g_Base.Stg.Mn.State.Now == D_DDM_STATE_ZEN || g_Base.Stg.Mn.State.Next == D_DDM_STATE_GMA || g_Base.Stg.Mn.State.Next == D_DDM_STATE_CZ) {
								//YES
									//アサート
							}
							else {
								//NO
								//ﾌﾞﾛｯｸ回数抽せん_通常ｽﾃ
								result = SubA_PrjCmn_SubLotFunc_GetEtcLot(D_LOT_O_NML_BLK_CNT_NML_STG);
								//[ﾌﾞﾛｯｸ回数]←結果
								g_Base.Stg.Nml.SubANmlBlkNum = result;

								//[ﾌﾞﾛｯｸ回数]>[ﾌﾞﾛｯｸ状況]?
								if (g_Base.Stg.Nml.SubANmlBlkNum > (u32)g_Base.Stg.Nml.SubANmlBlkSts) {
									//NO
									//[ﾌﾞﾛｯｸ全体G]←[前兆残G]+1
									g_Base.Stg.Nml.SubANmlBlkAllG = g_Base.Stg.Nml.SubANmlZenZanG + 1;

								}
								else {
									//YES
									//ﾌﾞﾛｯｸG数抽せん_1回目_通常ｽﾃ
									result = SubA_PrjCmn_SubLotFunc_GetEtcLot(D_LOT_O_NML_BLK_G_1_NML_STG);
									// [ﾌﾞﾛｯｸ全体G]←結果
									g_Base.Stg.Nml.SubANmlBlkAllG = result;

									//[ﾌﾞﾛｯｸ残G]←[ﾌﾞﾛｯｸ全体G]-1
									g_Base.Stg.Nml.SubANmlBlkZanG = g_Base.Stg.Nml.SubANmlBlkAllG - 1;

									//予約ｼﾅﾘｵ抽せん_通常ｽﾃ_1回目
									//[予約ｼﾅﾘｵ]←結果
									SubA_PrjCmn_SetSenario(D_LOT_S_NML_YOY_1, &g_Base.Stg.Nml.SubANmlSceYoy);

									//[通常ｼﾅﾘｵ属性]←[予約ｼﾅﾘｵ]の[ｴﾝﾌﾞﾚﾑ煽り用_ｼﾅﾘｵ属性]
									g_Base.Stg.Nml.SubANmlSceTypeAttr = D_SNR_EN_AORI_SINA_ZOKU;

									//予約ｼﾅﾘｵ決定時処理_NML共通
									SubA_PrjStgNml_NmlComYoySceDec();

									//[予約ｼﾅﾘｵG]←[予約ｼﾅﾘｵ]のｹﾞｰﾑ数
									g_Base.Stg.Nml.SubANmlSceYoyG = g_Base.Stg.Nml.SubANmlSceYoy.GameMax;

									//[ｼﾅﾘｵ開始G]←[ﾌﾞﾛｯｸ全体G]+[前兆進行G]-[予約ｼﾅﾘｵG]
									g_Base.Stg.Nml.SubANmlSceStaG = g_Base.Stg.Nml.SubANmlBlkAllG + g_Base.Stg.Nml.SubANmlZenPrgG - g_Base.Stg.Nml.SubANmlSceYoyG;
									//[ｼﾅﾘｵ開始までG]←[ｼﾅﾘｵ開始G]-[前兆進行G]
									g_Base.Stg.Nml.SubANmlSceForStaG = g_Base.Stg.Nml.SubANmlSceStaG - g_Base.Stg.Nml.SubANmlZenPrgG;
									//[前兆再設定ﾌﾗｸﾞ]←0
									g_Base.Stg.Nml.SubANmlZenSaiSetFlg = 0;
								}
							}
						}

					}

				}
				//[裏前兆全体G]←0
				g_Base.Stg.Nml.SubANmlUraZenAllG = 0;

				//[裏前兆進行G]←0
				g_Base.Stg.Nml.SubANmlUraZenPrgG = 0;

				//[裏前兆残G]←0
				g_Base.Stg.Nml.SubANmlUraZenZanG = 0;

			}
		}

